---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import logo from "@/assets/logo.png";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import HeaderSearch from "./HeaderSearch.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = "en";
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const navLinkClass =
  "interactive flex items-center gap-1 rounded-xl px-4 py-2.5 text-center font-medium text-muted-foreground hover:text-accent hover:bg-muted/50 sm:px-3 sm:py-2";

const toolsHref = getRelativeLocaleUrl(locale, "tools/compress-pdf");
const redactHref = getRelativeLocaleUrl(locale, "redact-preview");
const showSearch = features.search !== false;
---

<a
  id="skip-to-content"
  href="#main-content"
  class="glass-nav text-accent absolute inset-s-16 -top-full z-50 rounded-xl px-4 py-2.5 transition-all focus:top-4"
  data-i18n="site.a11y.skipToContent"
>
  {t.a11y.skipToContent}
</a>

<header class="sticky top-0 z-40 glass-nav border-b border-border/60">
  <div class="app-layout py-4 sm:py-5">
    <div class="flex w-full items-center gap-3 lg:gap-4">
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="site-brand interactive shrink-0 rounded-xl py-0.5 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        aria-label={site.title}
      >
        <Image
          src={logo}
          alt=""
          width={40}
          height={40}
          class="site-brand__logo"
          loading="eager"
          decoding="async"
        />
        <span class="site-brand__wordmark" aria-hidden="true">
          <span class="site-brand__tool">Tool</span><span class="site-brand__vx">VX</span>
        </span>
      </a>

      {
        showSearch && (
          <HeaderSearch
            locale={locale}
            class="header-search--desktop hidden min-w-0 shrink-0 lg:ms-8 lg:flex"
          />
        )
      }

      <nav
        id="nav-menu"
        class="ms-auto flex min-w-0 flex-col items-stretch lg:ms-0 lg:flex-row lg:items-center lg:justify-end lg:space-x-1"
      >
        <button
          id="menu-btn"
          class="focus-outline interactive self-end rounded-xl p-2.5 hover:bg-muted/50 lg:hidden"
          aria-label={t.a11y.openMenu}
          aria-expanded="false"
          aria-controls="menu-items"
          data-label-open={t.a11y.openMenu}
          data-label-close={t.a11y.closeMenu}
          data-label-open-key="site.a11y.openMenu"
          data-label-close-key="site.a11y.closeMenu"
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenuDeep id="menu-icon" />
        </button>

        <ul
          id="menu-items"
          class="mt-4 hidden w-full max-w-md grid-cols-2 place-content-center gap-1 lg:mt-0 lg:flex lg:w-auto lg:max-w-none lg:gap-x-1 lg:gap-y-0 [&>li>a]:block lg:[&>li]:h-auto"
        >
          {
            showSearch && (
              <li class="col-span-2 mb-1 lg:hidden">
                <HeaderSearch locale={locale} variant="menu" />
              </li>
            )
          }
          <li class="col-span-2 lg:col-span-1">
            <a
              href={toolsHref}
              class:list={[navLinkClass, { "active-nav": isActive("/tools") }]}
              data-i18n="site.nav.tools"
            >
              PDF Tools
            </a>
          </li>
          <li class="col-span-2 lg:col-span-1">
            <a
              href={redactHref}
              class:list={[navLinkClass, { "active-nav": isActive("/redact-preview") }]}
              data-i18n="site.nav.redact"
            >
              Redact
            </a>
          </li>
          <li class="col-span-2 lg:col-span-1">
            <a
              href={getRelativeLocaleUrl(locale, "posts")}
              class:list={[navLinkClass, { "active-nav": isActive("/posts") }]}
              data-i18n="site.nav.posts"
            >
              {t.nav.posts}
            </a>
          </li>
          <li class="col-span-2 lg:col-span-1">
            <a
              href={getRelativeLocaleUrl(locale, "tags")}
              class:list={[navLinkClass, { "active-nav": isActive("/tags") }]}
              data-i18n="site.nav.tags"
            >
              {t.nav.tags}
            </a>
          </li>
          <li class="col-span-2 lg:col-span-1">
            <a
              href={getRelativeLocaleUrl(locale, "about")}
              class:list={[navLinkClass, { "active-nav": isActive("/about") }]}
              data-i18n="site.nav.about"
            >
              {t.nav.about}
            </a>
          </li>
          {
            features.showArchives && (
              <li class="col-span-1 flex items-center justify-center lg:col-span-1">
                <LinkButton
                  href={getRelativeLocaleUrl(locale, "archives")}
                  class:list={[
                    "focus-outline interactive flex size-full justify-center rounded-xl p-3 hover:bg-muted/50 lg:relative lg:size-10 lg:p-0",
                    { "active-nav": isActive("/archives") },
                  ]}
                  title={t.nav.archives}
                  aria-label={t.nav.archives}
                  data-i18n-title="site.nav.archives"
                  data-i18n-aria-label="site.nav.archives"
                >
                  <IconArchive class="hidden lg:absolute lg:top-1/2 lg:left-1/2 lg:block lg:size-5 lg:-translate-x-1/2 lg:-translate-y-1/2" />
                  <span class="lg:sr-only" data-i18n="site.nav.archives">{t.nav.archives}</span>
                  {isActive("/archives") && (
                    <IconUnderline
                      aria-hidden="true"
                      class="scale-125 max-lg:hidden lg:absolute lg:bottom-0 lg:w-6"
                    />
                  )}
                </LinkButton>
              </li>
            )
          }
          {
            features.lightAndDarkMode && (
              <li class="col-span-1 flex items-center justify-center">
                <button
                  id="theme-btn"
                  class="focus-outline interactive hover:[&>svg]:stroke-accent relative size-10 rounded-xl p-2 hover:bg-muted/50"
                  title={t.a11y.toggleTheme}
                  aria-label={t.a11y.toggleTheme}
                  aria-live="polite"
                  data-i18n-title="site.a11y.toggleTheme"
                  data-i18n-aria-label="site.a11y.toggleTheme"
                >
                  <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </button>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);

      menuItems.classList.toggle("hidden");
      menuItems.classList.toggle("grid");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  function syncHeaderSearchQuery() {
    if (!window.location.pathname.endsWith("/search")) return;
    const query = new URLSearchParams(window.location.search).get("q") ?? "";
    document
      .querySelectorAll<HTMLInputElement>(".header-search__input")
      .forEach(input => {
        if (!input.value) input.value = query;
      });
  }

  function initHeader() {
    toggleNav();
    syncHeaderSearchQuery();
  }

  initHeader();
  document.addEventListener("astro:after-swap", initHeader);
</script>

<style>
  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  .site-brand__logo {
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: 9999px;
    object-fit: cover;
    box-shadow: 0 2px 10px color-mix(in oklab, var(--accent) 18%, transparent);
  }

  .site-brand__wordmark {
    display: none;
    align-items: baseline;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }

  .site-brand__tool {
    color: var(--foreground);
  }

  .site-brand__vx {
    background: linear-gradient(135deg, #f59e0b 0%, #ea580c 48%, #c2410c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  :global([data-theme="dark"]) .site-brand__vx,
  :global(.dark) .site-brand__vx {
    background: linear-gradient(135deg, #fcd34d 0%, #f59e0b 50%, #fb923c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (min-width: 640px) {
    .site-brand__logo {
      width: 2.5rem;
      height: 2.5rem;
    }

    .site-brand__wordmark {
      display: inline-flex;
      font-size: 1.375rem;
    }
  }

  @media (min-width: 1024px) {
    .header-search--desktop {
      width: 2.75rem;
      max-width: 2.75rem;
    }

    .header-search--desktop:focus-within {
      width: 8rem;
      max-width: 8rem;
    }
  }
</style>
