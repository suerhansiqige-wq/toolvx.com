---
import { getRelativeLocaleUrl } from "astro:i18n";
import { toolIconPaths, type ToolIcon } from "@/data/toolsMenu";
import { catalogs, type LocaleCode } from "@/i18n/messages";

type Props = {
  locale?: string;
};

const { locale = "en" } = Astro.props;
const catalog = catalogs[locale as LocaleCode] ?? catalogs.en;
const q = catalog.blog.home.toolQuick;

type QuickTile = {
  id: string;
  href?: string;
  icon: ToolIcon;
  title: string;
  titleKey: string;
  desc: string;
  descKey: string;
  accent: "redact" | "pdf" | "image" | "audio" | "ofd";
  comingSoon?: boolean;
};

const tiles: QuickTile[] = [
  {
    id: "redact",
    href: getRelativeLocaleUrl(locale, "redact-preview"),
    icon: "redact",
    title: q.redact,
    titleKey: "blog.home.toolQuick.redact",
    desc: q.redactDesc,
    descKey: "blog.home.toolQuick.redactDesc",
    accent: "redact",
  },
  {
    id: "pdf",
    href: getRelativeLocaleUrl(locale, "tools/compress-pdf"),
    icon: "compress",
    title: q.pdf,
    titleKey: "blog.home.toolQuick.pdf",
    desc: q.pdfDesc,
    descKey: "blog.home.toolQuick.pdfDesc",
    accent: "pdf",
  },
  {
    id: "image",
    href: getRelativeLocaleUrl(locale, "tools/pdf-to-jpg"),
    icon: "pdf-jpg",
    title: q.image,
    titleKey: "blog.home.toolQuick.image",
    desc: q.imageDesc,
    descKey: "blog.home.toolQuick.imageDesc",
    accent: "image",
  },
  {
    id: "audio",
    icon: "convert",
    title: q.audio,
    titleKey: "blog.home.toolQuick.audio",
    desc: q.audioDesc,
    descKey: "blog.home.toolQuick.audioDesc",
    accent: "audio",
    comingSoon: true,
  },
  {
    id: "ofd",
    icon: "word-pdf",
    title: q.ofd,
    titleKey: "blog.home.toolQuick.ofd",
    desc: q.ofdDesc,
    descKey: "blog.home.toolQuick.ofdDesc",
    accent: "ofd",
    comingSoon: true,
  },
];
---

<nav class="home-metro" aria-label={q.ariaLabel} data-i18n-aria-label="blog.home.toolQuick.ariaLabel">
  <div class="home-metro__grid">
    {
      tiles.map(tile => {
        const className = [
          "metro-tile",
          `metro-tile--${tile.accent}`,
          tile.comingSoon && "metro-tile--soon",
        ];

        const inner = (
          <>
            <span class="metro-tile__flash" aria-hidden="true"></span>
            <span class="metro-tile__gloss" aria-hidden="true"></span>
            <span class="metro-tile__art">
              <svg
                class="metro-tile__icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.85"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={toolIconPaths[tile.icon]}
              />
              <span class="metro-tile__label" data-i18n={tile.titleKey}>
                {tile.title}
              </span>
              {
                tile.comingSoon && (
                  <span class="metro-tile__badge" data-i18n="blog.home.toolQuick.comingSoon">
                    {q.comingSoon}
                  </span>
                )
              }
            </span>
            <span class="sr-only" data-i18n={tile.descKey}>
              {tile.desc}
            </span>
          </>
        );

        if (tile.comingSoon || !tile.href) {
          return (
            <div class:list={className} aria-disabled="true">
              {inner}
            </div>
          );
        }

        return (
          <a href={tile.href} class:list={className}>
            {inner}
          </a>
        );
      })
    }
  </div>
</nav>

<style>
  .home-metro {
    margin-bottom: 1.25rem;
    padding: 0.35rem;
    border-radius: 0.35rem;
    background:
      radial-gradient(circle at 18% 22%, color-mix(in oklab, #60a5fa 18%, transparent) 0%, transparent 42%),
      radial-gradient(circle at 82% 78%, color-mix(in oklab, #a78bfa 14%, transparent) 0%, transparent 38%),
      linear-gradient(160deg, #1e3a5f 0%, #0f172a 48%, #111827 100%);
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white 10%, transparent),
      0 10px 30px color-mix(in oklab, black 18%, transparent);
  }

  :global(.dark) .home-metro,
  :global([data-theme="dark"]) .home-metro {
    background:
      radial-gradient(circle at 20% 18%, color-mix(in oklab, #3b82f6 22%, transparent) 0%, transparent 40%),
      radial-gradient(circle at 78% 82%, color-mix(in oklab, #8b5cf6 16%, transparent) 0%, transparent 36%),
      linear-gradient(160deg, #0b1220 0%, #020617 100%);
  }

  .home-metro__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .metro-tile {
    position: relative;
    display: flex;
    min-height: 8.75rem;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 0;
    border-radius: 0.2rem;
    padding: 1rem 0.75rem;
    text-decoration: none;
    color: #fff;
    cursor: pointer;
    isolation: isolate;
    transition: transform 0.18s ease;
  }

  .metro-tile--redact {
    background: linear-gradient(160deg, #ff4d6d 0%, #e11d48 52%, #be123c 100%);
  }

  .metro-tile--pdf {
    background: linear-gradient(160deg, #a78bfa 0%, #7c3aed 55%, #5b21b6 100%);
  }

  .metro-tile--image {
    background: linear-gradient(160deg, #f472b6 0%, #db2777 55%, #9d174d 100%);
  }

  .metro-tile--audio {
    background: linear-gradient(160deg, #60a5fa 0%, #2563eb 55%, #1d4ed8 100%);
  }

  .metro-tile--ofd {
    background: linear-gradient(160deg, #38bdf8 0%, #0284c7 55%, #0369a1 100%);
  }

  .metro-tile--soon {
    cursor: not-allowed;
    filter: saturate(0.45) brightness(0.72);
  }

  .metro-tile__gloss {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      155deg,
      color-mix(in oklab, white 28%, transparent) 0%,
      transparent 42%,
      color-mix(in oklab, black 12%, transparent) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  .metro-tile__flash {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    pointer-events: none;
    z-index: 2;
  }

  .metro-tile:not(.metro-tile--soon):hover .metro-tile__flash,
  .metro-tile:not(.metro-tile--soon):focus-visible .metro-tile__flash {
    animation: metro-flash 0.65s ease-in-out;
  }

  .metro-tile:not(.metro-tile--soon):hover,
  .metro-tile:not(.metro-tile--soon):focus-visible {
    transform: scale(1.015);
  }

  .metro-tile:not(.metro-tile--soon):focus-visible {
    outline: 2px solid color-mix(in oklab, white 75%, transparent);
    outline-offset: 2px;
  }

  @keyframes metro-flash {
    0% {
      opacity: 0;
    }
    18% {
      opacity: 0.42;
    }
    36% {
      opacity: 0.08;
    }
    54% {
      opacity: 0.35;
    }
    72% {
      opacity: 0.05;
    }
    100% {
      opacity: 0;
    }
  }

  .metro-tile__art {
    position: relative;
    z-index: 3;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    text-align: center;
    text-shadow: 0 1px 2px color-mix(in oklab, black 28%, transparent);
  }

  .metro-tile__icon {
    width: 2.65rem;
    height: 2.65rem;
    flex-shrink: 0;
    color: #fff;
    filter: drop-shadow(0 2px 6px color-mix(in oklab, black 22%, transparent));
  }

  .metro-tile__label {
    max-width: 100%;
    font-size: 1.02rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.01em;
    color: #fff;
    word-break: break-word;
  }

  .metro-tile__badge {
    margin-top: 0.1rem;
    border-radius: 999px;
    padding: 0.12rem 0.5rem;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in oklab, white 92%, transparent);
    background: color-mix(in oklab, black 22%, transparent);
    border: 1px solid color-mix(in oklab, white 22%, transparent);
  }

  @media (min-width: 640px) {
    .home-metro {
      margin-bottom: 1.5rem;
      padding: 0.4rem;
    }

    .home-metro__grid {
      gap: 0.4rem;
    }

    .metro-tile {
      min-height: 10.25rem;
      padding: 1.2rem 1rem;
    }

    .metro-tile__icon {
      width: 3.1rem;
      height: 3.1rem;
    }

    .metro-tile__label {
      font-size: 1.15rem;
    }
  }
</style>
