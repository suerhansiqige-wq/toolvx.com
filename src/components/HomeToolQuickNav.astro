---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import ToolIconBadge from "@/components/tools/ToolIconBadge.astro";
import type { ToolIcon } from "@/data/toolsMenu";
import { catalogs, type LocaleCode } from "@/i18n/messages";

type Props = {
  locale?: string;
};

const { locale = "en" } = Astro.props;
const catalog = catalogs[locale as LocaleCode] ?? catalogs.en;
const q = catalog.blog.home.toolQuick;

type QuickTile = {
  id: string;
  href?: string;
  icon: ToolIcon;
  title: string;
  titleKey: string;
  desc: string;
  descKey: string;
  accent: "redact" | "pdf" | "image" | "audio" | "ofd";
  comingSoon?: boolean;
};

const tiles: QuickTile[] = [
  {
    id: "redact",
    href: getRelativeLocaleUrl(locale, "redact-preview"),
    icon: "redact",
    title: q.redact,
    titleKey: "blog.home.toolQuick.redact",
    desc: q.redactDesc,
    descKey: "blog.home.toolQuick.redactDesc",
    accent: "redact",
  },
  {
    id: "pdf",
    href: getRelativeLocaleUrl(locale, "tools/compress-pdf"),
    icon: "compress",
    title: q.pdf,
    titleKey: "blog.home.toolQuick.pdf",
    desc: q.pdfDesc,
    descKey: "blog.home.toolQuick.pdfDesc",
    accent: "pdf",
  },
  {
    id: "image",
    href: getRelativeLocaleUrl(locale, "tools/pdf-to-jpg"),
    icon: "pdf-jpg",
    title: q.image,
    titleKey: "blog.home.toolQuick.image",
    desc: q.imageDesc,
    descKey: "blog.home.toolQuick.imageDesc",
    accent: "image",
  },
  {
    id: "audio",
    icon: "convert",
    title: q.audio,
    titleKey: "blog.home.toolQuick.audio",
    desc: q.audioDesc,
    descKey: "blog.home.toolQuick.audioDesc",
    accent: "audio",
    comingSoon: true,
  },
  {
    id: "ofd",
    icon: "word-pdf",
    title: q.ofd,
    titleKey: "blog.home.toolQuick.ofd",
    desc: q.ofdDesc,
    descKey: "blog.home.toolQuick.ofdDesc",
    accent: "ofd",
    comingSoon: true,
  },
];
---

<nav class="home-tool-quick" aria-label={q.ariaLabel} data-i18n-aria-label="blog.home.toolQuick.ariaLabel">
  <div class="home-tool-quick__grid">
    {
      tiles.map(tile => {
        const className = [
          "home-tool-quick__tile",
          `home-tool-quick__tile--${tile.accent}`,
          tile.comingSoon && "home-tool-quick__tile--soon",
        ];

        const inner = (
          <>
            <div class="home-tool-quick__top">
              <ToolIconBadge icon={tile.icon} />
              {
                tile.comingSoon ? (
                  <span class="home-tool-quick__soon" data-i18n="blog.home.toolQuick.comingSoon">
                    {q.comingSoon}
                  </span>
                ) : (
                  <IconArrowRight class="home-tool-quick__arrow rtl:-rotate-180" aria-hidden="true" />
                )
              }
            </div>
            <div class="home-tool-quick__body">
              <span class="home-tool-quick__title" data-i18n={tile.titleKey}>
                {tile.title}
              </span>
              <span class="home-tool-quick__desc" data-i18n={tile.descKey}>
                {tile.desc}
              </span>
            </div>
          </>
        );

        if (tile.comingSoon || !tile.href) {
          return (
            <div class:list={className} aria-disabled="true">
              {inner}
            </div>
          );
        }

        return (
          <a href={tile.href} class:list={className}>
            {inner}
          </a>
        );
      })
    }
  </div>
</nav>

<style>
  .home-tool-quick {
    margin-bottom: 1.25rem;
  }

  .home-tool-quick__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.875rem;
  }

  .home-tool-quick__tile {
    position: relative;
    display: flex;
    min-height: 9.5rem;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid color-mix(in oklab, var(--border) 88%, transparent);
    padding: 1.15rem 1.2rem 1.2rem;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .home-tool-quick__tile::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 1;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .home-tool-quick__tile--redact {
    border-color: color-mix(in oklab, #e11d48 30%, var(--border));
  }

  .home-tool-quick__tile--redact::before {
    background:
      linear-gradient(145deg, color-mix(in oklab, #e11d48 14%, var(--card)) 0%, transparent 58%),
      linear-gradient(320deg, color-mix(in oklab, #fda4af 10%, var(--background)) 0%, transparent 45%),
      var(--card);
  }

  .home-tool-quick__tile--pdf {
    border-color: color-mix(in oklab, #8b5cf6 28%, var(--border));
  }

  .home-tool-quick__tile--pdf::before {
    background:
      linear-gradient(145deg, color-mix(in oklab, #8b5cf6 14%, var(--card)) 0%, transparent 58%),
      linear-gradient(320deg, color-mix(in oklab, #c4b5fd 10%, var(--background)) 0%, transparent 45%),
      var(--card);
  }

  .home-tool-quick__tile--image {
    border-color: color-mix(in oklab, #ec4899 28%, var(--border));
  }

  .home-tool-quick__tile--image::before {
    background:
      linear-gradient(145deg, color-mix(in oklab, #ec4899 14%, var(--card)) 0%, transparent 58%),
      linear-gradient(320deg, color-mix(in oklab, #f9a8d4 10%, var(--background)) 0%, transparent 45%),
      var(--card);
  }

  .home-tool-quick__tile--audio {
    border-color: color-mix(in oklab, #6366f1 24%, var(--border));
  }

  .home-tool-quick__tile--audio::before {
    background:
      linear-gradient(145deg, color-mix(in oklab, #6366f1 12%, var(--card)) 0%, transparent 58%),
      linear-gradient(320deg, color-mix(in oklab, #a5b4fc 10%, var(--background)) 0%, transparent 45%),
      var(--card);
  }

  .home-tool-quick__tile--ofd {
    border-color: color-mix(in oklab, #2563eb 24%, var(--border));
  }

  .home-tool-quick__tile--ofd::before {
    background:
      linear-gradient(145deg, color-mix(in oklab, #2563eb 12%, var(--card)) 0%, transparent 58%),
      linear-gradient(320deg, color-mix(in oklab, #93c5fd 10%, var(--background)) 0%, transparent 45%),
      var(--card);
  }

  .home-tool-quick__tile:not(.home-tool-quick__tile--soon) {
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white 48%, transparent),
      0 4px 18px color-mix(in oklab, black 5%, transparent);
  }

  .home-tool-quick__tile:not(.home-tool-quick__tile--soon):hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--accent) 38%, var(--border));
    box-shadow:
      0 12px 28px color-mix(in oklab, var(--accent) 10%, transparent),
      0 2px 8px color-mix(in oklab, black 6%, transparent);
  }

  .home-tool-quick__tile:not(.home-tool-quick__tile--soon):focus-visible {
    outline: 2px solid color-mix(in oklab, var(--accent) 55%, transparent);
    outline-offset: 2px;
  }

  .home-tool-quick__tile--soon {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .home-tool-quick__tile--soon::before {
    background: color-mix(in oklab, var(--muted) 38%, var(--card));
  }

  .home-tool-quick__top,
  .home-tool-quick__body {
    position: relative;
    z-index: 1;
  }

  .home-tool-quick__top {
    display: flex;
    width: 100%;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .home-tool-quick__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .home-tool-quick__title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }

  .home-tool-quick__desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: color-mix(in oklab, var(--muted-foreground) 90%, transparent);
  }

  .home-tool-quick__arrow {
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.15rem;
    color: color-mix(in oklab, var(--accent) 75%, var(--foreground));
    transition: transform 0.2s ease;
  }

  .home-tool-quick__tile:not(.home-tool-quick__tile--soon):hover .home-tool-quick__arrow {
    transform: translateX(3px);
  }

  .home-tool-quick__soon {
    flex-shrink: 0;
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: color-mix(in oklab, var(--muted-foreground) 88%, transparent);
    background: color-mix(in oklab, var(--background) 55%, var(--muted));
    border: 1px solid color-mix(in oklab, var(--border) 80%, transparent);
  }

  :global(.dark) .home-tool-quick__tile:not(.home-tool-quick__tile--soon) {
    box-shadow: inset 0 1px 0 color-mix(in oklab, white 7%, transparent);
  }

  :global(.dark) .home-tool-quick__tile--redact::before {
    background:
      linear-gradient(145deg, color-mix(in oklab, #e11d48 22%, var(--card)) 0%, transparent 62%),
      var(--card);
  }

  :global(.dark) .home-tool-quick__tile--pdf::before {
    background:
      linear-gradient(145deg, color-mix(in oklab, #8b5cf6 20%, var(--card)) 0%, transparent 62%),
      var(--card);
  }

  :global(.dark) .home-tool-quick__tile--image::before {
    background:
      linear-gradient(145deg, color-mix(in oklab, #ec4899 20%, var(--card)) 0%, transparent 62%),
      var(--card);
  }

  :global(.dark) .home-tool-quick__tile--audio::before {
    background:
      linear-gradient(145deg, color-mix(in oklab, #6366f1 18%, var(--card)) 0%, transparent 62%),
      var(--card);
  }

  :global(.dark) .home-tool-quick__tile--ofd::before {
    background:
      linear-gradient(145deg, color-mix(in oklab, #2563eb 18%, var(--card)) 0%, transparent 62%),
      var(--card);
  }

  :global(.dark) .home-tool-quick__tile--soon {
    opacity: 0.55;
  }

  @media (min-width: 640px) {
    .home-tool-quick {
      margin-bottom: 1.5rem;
    }

    .home-tool-quick__grid {
      gap: 1rem;
    }

    .home-tool-quick__tile {
      min-height: 10.5rem;
      padding: 1.25rem 1.35rem 1.3rem;
    }

    .home-tool-quick__title {
      font-size: 1.125rem;
    }
  }
</style>
