---
import type { HTMLAttributes } from "astro/types";

type Props = { disabled?: boolean; variant?: "default" | "button" } & HTMLAttributes<"a">;

const {
  disabled,
  variant = "default",
  class: className,
  ...attrs
} = Astro.props;

const Button = disabled ? "span" : "a";

const variantClass = {
  default: "group inline-flex items-center gap-1.5 interactive hover:text-accent",
  button:
    "group inline-flex items-center gap-2 interactive rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-accent-foreground shadow-ambient hover:-translate-y-0.5 hover:shadow-hover",
};
---

<Button
  aria-disabled={disabled}
  class:list={[
    variantClass[variant],
    { "pointer-events-none opacity-50": disabled },
    className,
  ]}
  {...attrs}
>
  <slot />
</Button>
