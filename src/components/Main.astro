---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  pageTitleI18n?: string;
  pageTitleVars?: Record<string, string>;
  pageDescI18n?: string;
  pageDescVars?: Record<string, string>;
  class?: string;
};

const {
  pageTitle,
  pageDesc,
  pageTitleI18n,
  pageTitleVars,
  pageDescI18n,
  pageDescVars,
  class: className,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout pb-12 pt-4 sm:pb-16 sm:pt-8", className]}
>
  <header class="mb-10 sm:mb-12">
    <h1
      class="text-foreground text-3xl font-bold tracking-tight sm:text-4xl"
      data-i18n={pageTitleI18n}
      data-i18n-vars={pageTitleVars ? JSON.stringify(pageTitleVars) : undefined}
    >
      {pageTitle}
    </h1>
    {
      pageDesc && (
        <p
          class="text-muted-foreground mt-4 max-w-2xl text-base leading-relaxed sm:text-lg"
          data-i18n={pageDescI18n}
          data-i18n-vars={pageDescVars ? JSON.stringify(pageDescVars) : undefined}
        >
          {pageDesc}
        </p>
      )
    }
  </header>
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
