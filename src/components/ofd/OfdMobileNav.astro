---
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  ofdToolIconPaths,
  ofdToolsRegistry,
  type OfdToolDefinition,
} from "@/data/ofdToolsRegistry";
import { catalogs, type LocaleCode } from "@/i18n/messages";

const currentPath = Astro.url.pathname;
const locale = "en";
const catalog = catalogs[locale as LocaleCode] ?? catalogs.en;

function isActive(href: string) {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<nav
  class="tool-mobile-nav lg:hidden"
  aria-label={catalog.ofd.workspace.sidebarAria}
  data-i18n-aria-label="ofd.workspace.sidebarAria"
  data-pagefind-ignore
>
  <div class="tool-mobile-nav__scroll" tabindex="-1">
    {
      ofdToolsRegistry.map((tool: OfdToolDefinition) => {
        const href = getRelativeLocaleUrl(locale, `ofd-tools/${tool.slug}`);
        const copy = catalog.ofd.tools[tool.i18nKey as keyof typeof catalog.ofd.tools];
        const active = isActive(href);
        return (
          <a
            href={href}
            class:list={["tool-mobile-nav__chip", active && "tool-mobile-nav__chip--active"]}
            aria-current={active ? "page" : undefined}
          >
            <span class="ofd-mobile-nav__icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={ofdToolIconPaths[tool.icon]}
              />
            </span>
            <span class="tool-mobile-nav__label" data-i18n={`ofd.tools.${tool.i18nKey}.title`}>
              {copy.title}
            </span>
          </a>
        );
      })
    }
  </div>
</nav>

<script>
  function scrollActiveOfdChipIntoView() {
    const active = document.querySelector<HTMLElement>(".tool-mobile-nav__chip--active");
    active?.scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" });
  }

  scrollActiveOfdChipIntoView();
  document.addEventListener("astro:page-load", scrollActiveOfdChipIntoView);
</script>

<style>
  .ofd-mobile-nav__icon {
    display: inline-flex;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.45rem;
    background: color-mix(in oklab, var(--accent) 12%, var(--muted));
    color: var(--accent);
  }

  .ofd-mobile-nav__icon :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  .tool-mobile-nav {
    margin-bottom: 1rem;
    margin-inline: calc(-1 * var(--layout-gutter));
  }

  .tool-mobile-nav__scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    padding-block: 0.125rem 0.375rem;
    padding-inline: var(--layout-gutter);
  }

  .tool-mobile-nav__scroll::-webkit-scrollbar {
    display: none;
  }

  .tool-mobile-nav__chip {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.45rem;
    scroll-snap-align: start;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklab, var(--border) 88%, transparent);
    background: color-mix(in oklab, var(--card) 92%, var(--muted) 8%);
    padding: 0.45rem 0.8rem 0.45rem 0.55rem;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--foreground);
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 0.18s ease,
      background-color 0.18s ease,
      color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .tool-mobile-nav__chip:hover {
    border-color: color-mix(in oklab, var(--accent) 35%, transparent);
    background: color-mix(in oklab, var(--accent) 8%, var(--card));
    color: var(--accent);
  }

  .tool-mobile-nav__chip--active {
    border-color: color-mix(in oklab, var(--accent) 45%, transparent);
    background: color-mix(in oklab, var(--accent) 12%, var(--card));
    color: var(--accent);
    font-weight: 600;
    box-shadow: 0 2px 10px color-mix(in oklab, var(--accent) 16%, transparent);
  }

  .tool-mobile-nav__label {
    max-width: 8.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
