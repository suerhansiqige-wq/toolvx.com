---
import type { OfdToolSEO } from "@/data/ofdToolsSeo";
import AdSlot from "@/components/AdSlot.astro";

type Props = {
  seo: OfdToolSEO;
  toolI18nKey: string;
  faqAdSlotId?: string;
  class?: string;
};

const { seo, toolI18nKey, faqAdSlotId, class: className } = Astro.props;
const prefix = `ofd.seoRich.${toolI18nKey}`;
const whatId = `ofd-seo-what-${seo.id}`;
const howId = `ofd-seo-how-${seo.id}`;
const whyId = `ofd-seo-why-${seo.id}`;
const faqId = `ofd-seo-faq-${seo.id}`;

const faqMid = Math.ceil(seo.faqs.length / 2);
const faqsBeforeAd = seo.faqs.slice(0, faqMid);
const faqsAfterAd = seo.faqs.slice(faqMid);
---

<section
  class:list={["ofd-seo-article border-border mt-10 border-t pt-10", className]}
  aria-labelledby={whatId}
  data-pagefind-body
>
  <h2
    id={whatId}
    class="text-foreground mb-4 text-2xl font-bold tracking-tight sm:text-3xl"
    data-i18n={`${prefix}.whatIsHeading`}
  >
    What is {seo.h1}?
  </h2>
  <p
    class="text-muted-foreground mb-4 text-base leading-relaxed"
    data-i18n={`${prefix}.whatIs`}
  >
    {seo.whatIs}
  </p>
  <ul class="text-muted-foreground mb-10 list-disc space-y-2 ps-6 text-base leading-relaxed">
    {
      seo.scenarios.map((item, index) => (
        <li class="text-foreground/90" data-i18n={`${prefix}.scenarios.${index}`}>
          {item}
        </li>
      ))
    }
  </ul>

  <h2
    id={howId}
    class="text-foreground mb-4 text-2xl font-bold tracking-tight sm:text-3xl"
    data-i18n="ofd.seoHeadings.howTo"
  >
    How to use this tool
  </h2>
  <ol class="text-muted-foreground mb-10 list-decimal space-y-3 ps-6 text-base leading-relaxed">
    {
      seo.steps.map((step, index) => (
        <li class="text-foreground/90" data-i18n={`${prefix}.steps.${index}`}>
          {step}
        </li>
      ))
    }
  </ol>

  <h2
    id={whyId}
    class="text-foreground mb-4 text-2xl font-bold tracking-tight sm:text-3xl"
    data-i18n="ofd.seoHeadings.whyChoose"
  >
    Why choose our browser-based OFD tool?
  </h2>
  <p
    class="text-muted-foreground mb-4 text-base leading-relaxed"
    data-i18n={`${prefix}.whyChoose`}
  >
    {seo.whyChoose}
  </p>
  <ul class="text-muted-foreground mb-10 list-disc space-y-2 ps-6 text-base leading-relaxed">
    {
      seo.whyChoosePoints.map((point, index) => (
        <li class="text-foreground/90" data-i18n={`${prefix}.whyChoosePoints.${index}`}>
          {point}
        </li>
      ))
    }
  </ul>

  <h2
    id={faqId}
    class="text-foreground mb-6 text-2xl font-bold tracking-tight sm:text-3xl"
    data-i18n="ofd.seoHeadings.faq"
  >
    Frequently asked questions
  </h2>
  <div class="space-y-8">
    {
      faqsBeforeAd.map((faq, index) => (
        <div class="border-border border-b pb-8">
          <h3
            class="text-foreground mb-3 text-lg font-semibold tracking-tight"
            data-i18n={`${prefix}.faqs.${index}.question`}
          >
            {faq.question}
          </h3>
          <p
            class="text-muted-foreground text-base leading-relaxed"
            data-i18n={`${prefix}.faqs.${index}.answer`}
          >
            {faq.answer}
          </p>
        </div>
      ))
    }

    <AdSlot
      variant="in-article"
      slotId={faqAdSlotId}
      data-ad-position="ofd-faq-in-article"
    />

    {
      faqsAfterAd.map((faq, index) => {
        const faqIndex = index + faqsBeforeAd.length;
        return (
          <div class="border-border border-b pb-8 last:border-b-0 last:pb-0">
            <h3
              class="text-foreground mb-3 text-lg font-semibold tracking-tight"
              data-i18n={`${prefix}.faqs.${faqIndex}.question`}
            >
              {faq.question}
            </h3>
            <p
              class="text-muted-foreground text-base leading-relaxed"
              data-i18n={`${prefix}.faqs.${faqIndex}.answer`}
            >
              {faq.answer}
            </p>
          </div>
        );
      })
    }
  </div>
</section>
