---
import { getRelativeLocaleUrl } from "astro:i18n";
import OfdIconBadge from "@/components/ofd/OfdIconBadge.astro";
import { ofdToolsRegistry, type OfdToolDefinition } from "@/data/ofdToolsRegistry";
import { catalogs, type LocaleCode } from "@/i18n/messages";

const currentPath = Astro.url.pathname;
const locale = "en";
const catalog = catalogs[locale as LocaleCode] ?? catalogs.en;

function isActive(href: string) {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<nav
  class="tool-sidebar-nav ofd-sidebar-nav"
  aria-label={catalog.ofd.workspace.sidebarAria}
  data-i18n-aria-label="ofd.workspace.sidebarAria"
  data-pagefind-ignore
>
  {
    ofdToolsRegistry.map((tool: OfdToolDefinition, index) => {
      const href = getRelativeLocaleUrl(locale, `ofd-tools/${tool.slug}`);
      const copy = catalog.ofd.tools[tool.i18nKey as keyof typeof catalog.ofd.tools];
      const active = isActive(href);
      return (
        <a
          href={href}
          class:list={[
            "tool-sidebar-nav__link",
            index > 0 && "tool-sidebar-nav__link--group-start",
            active && "tool-sidebar-nav__link--active",
          ]}
          aria-current={active ? "page" : undefined}
        >
          <span class="tool-sidebar-nav__icon">
            <OfdIconBadge icon={tool.icon} accent={tool.accent} size="sm" />
          </span>
          <span class="tool-sidebar-nav__label" data-i18n={`ofd.tools.${tool.i18nKey}.title`}>
            {copy.title}
          </span>
        </a>
      );
    })
  }
  <div class="tool-sidebar-nav__spacer" aria-hidden="true"></div>
</nav>

<script>
  import { syncToolSidebarWidth } from "@/scripts/tool-sidebar-width";

  function initOfdSidebar() {
    syncToolSidebarWidth();
  }

  initOfdSidebar();
  document.addEventListener("astro:after-swap", initOfdSidebar);
  document.addEventListener("astro:page-load", initOfdSidebar);
</script>

<style>
  .tool-sidebar-nav {
    display: inline-grid;
    grid-auto-rows: auto;
    justify-items: stretch;
    width: max-content;
    min-width: max-content;
    overflow: visible;
    --tool-sidebar-width-extra: 1.5rem;
    --tool-sidebar-hover-slack: 0.875rem;
    padding-inline: 0.125rem;
    padding-inline-end: var(--tool-sidebar-hover-slack);
    padding-block-end: 0.5rem;
    box-sizing: border-box;
  }

  .tool-sidebar-nav__spacer {
    display: block;
    height: 2.5rem;
    width: 100%;
    flex-shrink: 0;
  }

  .tool-sidebar-nav__link--group-start {
    margin-top: 0.75rem;
  }

  .tool-sidebar-nav__link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    box-sizing: border-box;
    overflow: visible;
    padding: 0.5rem 1.125rem;
    border-radius: 0.75rem;
    border: 1px solid transparent;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.375;
    color: var(--foreground);
    text-decoration: none;
    transition:
      transform 0.22s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.22s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.22s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.22s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tool-sidebar-nav__link:hover {
    transform: translateX(6px);
    border-color: color-mix(in oklab, var(--accent) 35%, transparent);
    background: color-mix(in oklab, var(--accent) 10%, var(--background));
    box-shadow:
      inset 3px 0 0 var(--accent),
      0 4px 14px color-mix(in oklab, var(--accent) 18%, transparent);
    color: var(--accent);
  }

  .tool-sidebar-nav__link--active {
    transform: translateX(4px);
    border-color: color-mix(in oklab, var(--accent) 42%, transparent);
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--accent) 14%, var(--background)) 0%,
      color-mix(in oklab, var(--accent) 6%, var(--background)) 100%
    );
    box-shadow:
      inset 3px 0 0 var(--accent),
      0 2px 10px color-mix(in oklab, var(--accent) 16%, transparent),
      0 1px 0 color-mix(in oklab, white 65%, transparent);
    font-weight: 600;
    color: var(--accent);
  }

  .tool-sidebar-nav__link--active:hover {
    transform: translateX(6px);
  }

  .tool-sidebar-nav__icon {
    flex-shrink: 0;
    transition: transform 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tool-sidebar-nav__link:hover .tool-sidebar-nav__icon {
    transform: translateY(-3px) scale(1.1);
  }

  .tool-sidebar-nav__link--active .tool-sidebar-nav__icon {
    transform: scale(1.06);
  }

  .tool-sidebar-nav__label {
    flex: 1 1 auto;
    min-width: max-content;
    white-space: nowrap;
    overflow: visible;
    text-align: start;
  }

  .tool-sidebar-nav__link:hover :global(.ofd-icon-badge) {
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white 68%, transparent),
      inset 0 -2px 0 color-mix(in oklab, black 16%, transparent),
      0 4px 8px color-mix(in oklab, black 16%, transparent),
      0 14px 24px color-mix(in oklab, var(--accent) 30%, transparent);
  }

  :global(.dark) .tool-sidebar-nav__link:hover {
    background: color-mix(in oklab, var(--accent) 16%, transparent);
    box-shadow:
      inset 3px 0 0 var(--accent),
      0 4px 18px color-mix(in oklab, var(--accent) 22%, transparent);
  }

  :global(.dark) .tool-sidebar-nav__link--active {
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--accent) 20%, transparent) 0%,
      color-mix(in oklab, var(--accent) 8%, transparent) 100%
    );
  }
</style>
