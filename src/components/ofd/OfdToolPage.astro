---
import type { OfdToolDefinition } from "@/data/ofdToolsRegistry";
import { getOfdToolSeoOrThrow } from "@/data/ofdToolsSeo";
import OfdLayout from "@/layouts/OfdLayout.astro";
import OfdWorkspace from "@/components/ofd/OfdWorkspace.astro";
import OfdSeoArticle from "@/components/ofd/OfdSeoArticle.astro";
import AdSlot from "@/components/AdSlot.astro";

type Props = {
  tool: OfdToolDefinition;
};

const { tool } = Astro.props;
const seo = getOfdToolSeoOrThrow(tool.slug);
const pageTitle = seo.title;
const pageDescription = seo.description;
const canonicalURL = new URL(`/ofd-tools/${tool.slug}/`, Astro.site).href;
const adPrefix = `ofd-${tool.slug}`;
---

<OfdLayout
  title={pageTitle}
  description={pageDescription}
  keywords={seo.keywords.join(", ")}
  canonicalURL={canonicalURL}
  appName={seo.h1}
  faqs={seo.faqs}
  steps={seo.steps}
>
  <OfdWorkspace tool={tool} />

  <!-- Ad B: below tool (rectangle / medium rectangle) -->
  <AdSlot
    variant="rectangle"
    slotId={`${adPrefix}-rectangle-mid`}
    data-ad-position="ofd-mid-rectangle"
    class="mt-8"
  />

  <!-- Deep SEO content + Ad C inside FAQ -->
  <OfdSeoArticle
    seo={seo}
    toolI18nKey={tool.i18nKey}
    faqAdSlotId={`${adPrefix}-faq-in-article`}
  />
</OfdLayout>
