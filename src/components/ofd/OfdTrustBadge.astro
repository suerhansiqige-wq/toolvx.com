---
import { catalogs, type LocaleCode } from "@/i18n/messages";

type Props = {
  locale?: string;
};

const { locale = "en" } = Astro.props;
const ws = (catalogs[locale as LocaleCode] ?? catalogs.en).ofd.workspace;
---

<section
  class="trust-badge mt-8 rounded-2xl border border-emerald-200/80 bg-emerald-50/60 p-6 dark:border-emerald-900/50 dark:bg-emerald-950/25 sm:p-8"
  aria-labelledby="ofd-trust-badge-title"
  data-pagefind-ignore
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-5">
    <div
      class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-emerald-500 text-white shadow-md shadow-emerald-500/25"
      aria-hidden="true"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-6"
      >
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        <path d="m9 12 2 2 4-4"></path>
      </svg>
    </div>

    <div class="min-w-0 flex-1">
      <h2
        id="ofd-trust-badge-title"
        class="text-foreground text-lg font-bold leading-snug tracking-tight sm:text-xl"
        data-i18n="ofd.workspace.trustTitle"
      >
        {ws.trustTitle}
      </h2>
      <p
        class="text-muted-foreground mt-2 text-sm leading-relaxed sm:text-base"
        data-i18n="ofd.workspace.trustSub"
      >
        {ws.trustSub}
      </p>

      <ul class="mt-4 space-y-2.5" role="list">
        <li class="flex items-start gap-2.5 text-sm text-foreground/90">
          <span
            class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              class="size-3"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </span>
          <span data-i18n="ofd.workspace.trustCheck1">{ws.trustCheck1}</span>
        </li>
        <li class="flex items-start gap-2.5 text-sm text-foreground/90">
          <span
            class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              class="size-3"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </span>
          <span data-i18n="ofd.workspace.trustCheck2">{ws.trustCheck2}</span>
        </li>
        <li class="flex items-start gap-2.5 text-sm text-foreground/90">
          <span
            class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              class="size-3"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </span>
          <span data-i18n="ofd.workspace.trustCheck3">{ws.trustCheck3}</span>
        </li>
      </ul>
    </div>
  </div>
</section>
