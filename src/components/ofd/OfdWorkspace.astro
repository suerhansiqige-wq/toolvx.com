---
import type { OfdToolDefinition } from "@/data/ofdToolsRegistry";
import OfdTrustBadge from "@/components/ofd/OfdTrustBadge.astro";
import { catalogs, type LocaleCode } from "@/i18n/messages";

type Props = {
  tool: OfdToolDefinition;
  locale?: string;
};

const { tool, locale = "en" } = Astro.props;
const catalog = catalogs[locale as LocaleCode] ?? catalogs.en;
const copy = catalog.ofd.tools[tool.i18nKey as keyof typeof catalog.ofd.tools];
const ws = catalog.ofd.workspace;
const titleKey = `ofd.tools.${tool.i18nKey}.title`;
const taglineKey = `ofd.tools.${tool.i18nKey}.desc`;
---

<section class="card-surface shadow-elevated mb-10 p-6 sm:p-10" data-pagefind-body>
  <div class="mb-8 text-center">
    <h1
      class="text-foreground mb-2 text-3xl font-bold tracking-tight sm:text-4xl"
      data-i18n={titleKey}
    >
      {copy.title}
    </h1>
    <p class="text-muted-foreground mx-auto max-w-2xl text-sm sm:text-base" data-i18n={taglineKey}>
      {copy.desc}
    </p>
  </div>

  <div
    id="ofd-tool-root"
    data-mode={tool.mode}
    data-slug={tool.slug}
    data-i18n-key={tool.i18nKey}
    data-multiple={tool.multiple ? "true" : "false"}
  >
    <div
      id="ofd-drop-zone"
      data-dropzone
      class="border-border bg-muted/30 hover:border-accent interactive group relative cursor-pointer rounded-2xl border-2 border-dashed p-8 transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] sm:p-12"
    >
      <input
        id="ofd-file-input"
        type="file"
        accept=".ofd,application/ofd,application/octet-stream"
        multiple={tool.multiple ?? false}
        class="file-input-overlay"
        aria-label={tool.multiple ? ws.uploadMultiHint : ws.uploadHint}
      />

      <div id="ofd-drop-empty" data-dropzone-empty class="dropzone-empty relative z-0">
        <p class="text-foreground text-base font-medium" data-i18n="ofd.workspace.uploadHint">
          {tool.multiple ? ws.uploadMultiHint : ws.uploadHint}
        </p>
        <p class="text-muted-foreground mt-2 text-sm" data-i18n="ofd.workspace.uploadSubhint">
          {ws.uploadSubhint}
        </p>
      </div>

      <div
        id="ofd-drop-filled"
        data-dropzone-preview
        class="dropzone-preview hidden w-full min-h-0 flex-1 flex-col"
      >
        <div
          id="ofd-file-chips"
          data-dropzone-thumbs
          class="dropzone-thumbs-scroll flex min-h-0 min-w-0 flex-1 flex-nowrap items-stretch gap-4 overflow-x-auto"
        >
        </div>
      </div>
    </div>

    <p id="ofd-status" class="text-muted-foreground mt-3 min-h-[1.25rem] text-sm" aria-live="polite"
    ></p>

    <div class="mt-8 grid w-full grid-cols-1 gap-3 sm:grid-cols-2">
      <button
        id="ofd-action-btn"
        type="button"
        class="interactive bg-accent text-accent-foreground h-14 rounded-[1rem] border-2 border-transparent px-4 text-base font-bold disabled:cursor-not-allowed disabled:opacity-45"
        disabled
      >
        <span data-i18n="ofd.workspace.convert">{ws.convert}</span>
      </button>
      <a
        id="ofd-download-btn"
        href="#"
        download
        class="interactive pointer-events-none flex h-14 items-center justify-center rounded-[1rem] border-2 border-border bg-card px-4 text-base font-bold opacity-45"
      >
        <span data-i18n="ofd.workspace.download">{ws.download}</span>
      </a>
    </div>
  </div>
</section>

<OfdTrustBadge locale={locale} />

<style>
  #ofd-drop-zone.ofd-drop-zone--active {
    border-color: color-mix(in oklab, var(--accent) 55%, transparent);
    background: color-mix(in oklab, var(--accent) 8%, var(--muted));
  }

  #ofd-drop-zone.has-files {
    display: flex;
    flex-direction: column;
    min-height: 14rem;
    border-color: color-mix(in oklab, var(--accent) 55%, transparent);
    background-color: color-mix(in oklab, var(--card) 65%, transparent);
    padding: 1rem 1.25rem;
    cursor: default;
  }

  #ofd-drop-zone.has-files .dropzone-preview:not(.hidden) {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 12rem;
  }

  :global(.ofd-thumb-progress) {
    width: 100%;
    padding: 0 0.25rem;
  }

  :global(.ofd-thumb-progress__track) {
    height: 0.375rem;
    width: 100%;
    overflow: hidden;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--muted) 85%, transparent);
  }

  :global(.ofd-thumb-progress__bar) {
    height: 100%;
    border-radius: 9999px;
    background: var(--accent);
    transition: width 0.2s ease-out;
  }

  :global(.ofd-thumb-progress__label) {
    margin-top: 0.35rem;
    text-align: center;
    font-size: 0.625rem;
    color: var(--muted-foreground);
  }
</style>

<script>
  import "@/scripts/ofd-tool.client.ts";
</script>
