---
type Props = {
  id?: string;
  inputId?: string;
  accept: string;
  hint: string;
  subhint?: string;
  hintI18n?: string;
  subhintI18n?: string;
  multiple?: boolean;
  class?: string;
};

const {
  id = "drop-zone",
  inputId = "file-input",
  accept,
  hint,
  subhint,
  hintI18n,
  subhintI18n,
  multiple = false,
  class: className,
} = Astro.props;
---

<div
  id={id}
  data-dropzone
  data-input-id={inputId}
  class:list={[
    "border-border bg-muted/30 hover:border-accent interactive group relative cursor-pointer rounded-2xl border-2 border-dashed p-8 transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] sm:p-12",
    className,
  ]}
>
  <input
    type="file"
    id={inputId}
    accept={accept}
    multiple={multiple}
    class="file-input-overlay"
    aria-label={hint}
  />

  <div data-dropzone-empty class="dropzone-empty relative z-0">
    <p class="text-foreground text-base font-medium" data-i18n={hintI18n}>{hint}</p>
    {
      subhint && (
        <p class="text-muted-foreground mt-2 text-sm" data-i18n={subhintI18n}>
          {subhint}
        </p>
      )
    }
  </div>

  <div data-dropzone-preview class="dropzone-preview hidden w-full min-h-0 flex-1 flex-col">
    <div
      data-dropzone-thumbs
      class="dropzone-thumbs-scroll flex min-h-0 min-w-0 flex-1 flex-nowrap items-stretch gap-4 overflow-x-auto"
    >
    </div>
  </div>
</div>

<style>
  [data-dropzone].has-files {
    display: flex;
    flex-direction: column;
    min-height: 14rem;
    border-color: var(--accent);
    background-color: var(--card);
    border-color: color-mix(in oklab, var(--accent) 55%, transparent);
    background-color: color-mix(in oklab, var(--card) 65%, transparent);
    padding: 1rem 1.25rem;
  }

  [data-dropzone].has-files .dropzone-preview:not(.hidden) {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 12rem;
  }

  :global(.dropzone-page-thumb__preview) {
    margin: 0;
    padding: 0;
    appearance: none;
    font: inherit;
    text-align: inherit;
  }

  :global(.merge-dropzone-item__preview) {
    margin: 0;
    padding: 0;
    appearance: none;
    font: inherit;
    text-align: inherit;
  }

  :global(.merge-dropzone-item__preview:focus-visible),
  :global(.dropzone-page-thumb__preview:focus-visible),
  :global(.dropzone-add-card:focus-visible),
  :global(.dropzone-thumb-remove:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global(.dropzone-thumb-remove) {
    font-size: 1.35rem;
    line-height: 1;
  }
</style>
