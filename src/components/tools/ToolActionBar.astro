---
type Props = {
  actionLabel: string;
  actionI18n: string;
  downloadLabel: string;
  downloadI18n: string;
};

const { actionLabel, actionI18n, downloadLabel, downloadI18n } = Astro.props;
---

<div id="tool-action-bar" class="mt-8 w-full" aria-live="polite">
  <div class="flex w-full flex-col items-center gap-3">
    <div
      class="tool-action-segment grid w-full grid-cols-2 gap-1 rounded-[1.25rem] p-1"
      role="group"
      aria-label="Tool actions"
      data-i18n-aria-label="blog.layout.toolActions"
    >
      <button
        type="button"
        id="tool-action-btn"
        class="tool-action-btn interactive flex h-14 w-full min-w-0 items-center justify-center gap-2.5 rounded-[1rem] border-2 px-4 text-base font-bold tracking-tight transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] disabled:cursor-not-allowed"
        disabled
      >
        <span
          class="tool-action-btn__icon flex size-8 shrink-0 items-center justify-center rounded-lg"
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4"
          >
            <path d="M12 2v8" /><path d="m8 6 4-4 4 4" /><path d="M4 14v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4" />
          </svg>
        </span>
        <span class="truncate" data-i18n={actionI18n}>{actionLabel}</span>
      </button>

      <a
        id="tool-download-btn"
        href="#"
        download
        class="tool-download-btn interactive flex h-14 w-full min-w-0 items-center justify-center gap-2.5 rounded-[1rem] border-2 px-4 text-base font-bold tracking-tight transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)]"
        aria-disabled="true"
        tabindex="-1"
      >
        <span
          class="tool-download-btn__icon flex size-8 shrink-0 items-center justify-center rounded-lg"
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4"
          >
            <path d="M12 15V3" /><path d="m7 10 5 5 5-5" /><path d="M4 19h16" />
          </svg>
        </span>
        <span class="truncate" data-i18n={downloadI18n}>{downloadLabel}</span>
      </a>
    </div>

    <div id="tool-success-row" class="hidden items-center justify-center gap-2">
      <span class="tool-success-badge inline-flex items-center gap-1.5 rounded-full px-3.5 py-1 text-xs font-semibold tracking-wide">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-3.5"
          aria-hidden="true"
        >
          <path d="M20 6 9 17l-5-5" />
        </svg>
        <span data-i18n="common.success">Done! Your file is ready.</span>
      </span>
    </div>

    <div
      id="tool-multi-download"
      class="tool-action-segment hidden w-full grid-cols-2 gap-1 rounded-[1.25rem] p-1"
    >
    </div>

    <p id="tool-stats" class="text-muted-foreground hidden text-center text-sm"></p>
  </div>
</div>

<style>
  .tool-action-segment {
    border: 1px solid #d1d5db;
    background: #f3f4f6;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 4px 18px rgba(0, 0, 0, 0.08);
  }

  :global([data-theme="dark"]) .tool-action-segment,
  :global(.dark) .tool-action-segment {
    border-color: #4b5563;
    background: #1f2937;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 6px 24px rgba(0, 0, 0, 0.45);
  }

  .tool-action-btn {
    color: #ffffff;
    border-color: #818cf8;
    background: linear-gradient(180deg, #6366f1 0%, #4f46e5 52%, #4338ca 100%);
    box-shadow:
      0 0 0 1px rgba(79, 70, 229, 0.35),
      0 6px 20px rgba(79, 70, 229, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.28);
  }

  .tool-action-btn__icon {
    color: inherit;
    background: rgba(255, 255, 255, 0.22);
  }

  .tool-action-btn:disabled {
    opacity: 1;
    color: #e0e7ff;
    border-color: #a5b4fc;
    background: linear-gradient(180deg, #4338ca 0%, #3730a3 100%);
    box-shadow:
      0 0 0 1px rgba(129, 140, 248, 0.45),
      0 0 18px rgba(99, 102, 241, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .tool-action-btn:not(:disabled):hover {
    transform: translateY(-1px);
    border-color: #a5b4fc;
    background: linear-gradient(180deg, #818cf8 0%, #6366f1 52%, #4f46e5 100%);
    box-shadow:
      0 0 0 1px rgba(99, 102, 241, 0.5),
      0 10px 28px rgba(79, 70, 229, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.32);
  }

  :global([data-theme="dark"]) .tool-action-btn,
  :global(.dark) .tool-action-btn {
    color: #042f2e;
    border-color: #67e8f9;
    background: linear-gradient(180deg, #67e8f9 0%, #22d3ee 48%, #06b6d4 100%);
    box-shadow:
      0 0 0 1px rgba(34, 211, 238, 0.55),
      0 6px 22px rgba(6, 182, 212, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.45);
  }

  :global([data-theme="dark"]) .tool-action-btn:disabled,
  :global(.dark) .tool-action-btn:disabled {
    color: #cffafe;
    border-color: #22d3ee;
    background: linear-gradient(180deg, #155e75 0%, #0e7490 100%);
    box-shadow:
      0 0 0 1px rgba(34, 211, 238, 0.55),
      0 0 20px rgba(34, 211, 238, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  :global([data-theme="dark"]) .tool-action-btn:not(:disabled):hover,
  :global(.dark) .tool-action-btn:not(:disabled):hover {
    border-color: #a5f3fc;
    background: linear-gradient(180deg, #a5f3fc 0%, #67e8f9 48%, #22d3ee 100%);
    box-shadow:
      0 0 0 1px rgba(165, 243, 252, 0.65),
      0 12px 30px rgba(34, 211, 238, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  .tool-download-btn {
    pointer-events: none;
    color: #6b7280;
    border-color: #d1d5db;
    background: linear-gradient(180deg, #ffffff 0%, #f3f4f6 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .tool-download-btn .tool-download-btn__icon {
    color: #9ca3af;
    background: #e5e7eb;
  }

  :global([data-theme="dark"]) .tool-download-btn,
  :global(.dark) .tool-download-btn {
    color: #e5e7eb;
    border-color: #9ca3af;
    background: linear-gradient(180deg, #4b5563 0%, #374151 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 2px 10px rgba(0, 0, 0, 0.25);
  }

  :global([data-theme="dark"]) .tool-download-btn .tool-download-btn__icon,
  :global(.dark) .tool-download-btn .tool-download-btn__icon {
    color: #f3f4f6;
    background: #6b7280;
  }

  .tool-download-btn.is-ready {
    pointer-events: auto;
    color: #ffffff;
    border-color: #34d399;
    background: linear-gradient(180deg, #34d399 0%, #10b981 52%, #059669 100%);
    box-shadow:
      0 0 0 1px rgba(16, 185, 129, 0.45),
      0 6px 20px rgba(16, 185, 129, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.28);
  }

  .tool-download-btn.is-ready .tool-download-btn__icon {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.22);
  }

  .tool-download-btn.is-ready:hover {
    transform: translateY(-1px);
    border-color: #6ee7b7;
    background: linear-gradient(180deg, #6ee7b7 0%, #34d399 52%, #10b981 100%);
    box-shadow:
      0 0 0 1px rgba(52, 211, 153, 0.55),
      0 10px 28px rgba(16, 185, 129, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.32);
  }

  @supports (color: color-mix(in oklab, white, black)) {
    .tool-action-segment {
      border: 1px solid color-mix(in oklab, var(--border) 80%, transparent);
      background: color-mix(in oklab, var(--muted) 55%, transparent);
      box-shadow:
        inset 0 1px 0 color-mix(in oklab, white 70%, transparent),
        0 1px 2px color-mix(in oklab, black 4%, transparent),
        0 8px 24px color-mix(in oklab, black 4%, transparent);
    }

    :global(.dark) .tool-action-segment {
      box-shadow:
        inset 0 1px 0 color-mix(in oklab, white 6%, transparent),
        0 1px 2px color-mix(in oklab, black 20%, transparent),
        0 8px 24px color-mix(in oklab, black 25%, transparent);
    }
  }

  .tool-success-badge {
    color: #047857;
    border: 1px solid color-mix(in oklab, #10b981 22%, transparent);
    background: color-mix(in oklab, #10b981 10%, transparent);
  }

  :global(.dark) .tool-success-badge {
    color: #6ee7b7;
    border-color: color-mix(in oklab, #34d399 25%, transparent);
    background: color-mix(in oklab, #10b981 14%, transparent);
  }

  :global(.tool-page-thumb-card) {
    text-decoration: none;
    color: inherit;
  }

  :global(.tool-page-thumb-card__preview) {
    display: block;
    margin: 0;
    padding: 0;
    border: none;
    appearance: none;
    text-align: inherit;
    font: inherit;
  }

  :global(.tool-page-thumb-card__preview:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  :global(.tool-page-thumb-card__preview) {
    border-bottom: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
  }
</style>
