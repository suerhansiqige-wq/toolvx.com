---
import type { ToolIcon } from "@/data/toolsMenu";
import { toolIconPaths } from "@/data/toolsMenu";

type Props = {
  icon: ToolIcon;
  size?: "sm" | "md";
};

const { icon, size = "md" } = Astro.props;
---

<span
  class:list={["tool-icon-badge", `tool-icon-badge--${icon}`, size === "sm" && "tool-icon-badge--sm"]}
  aria-hidden="true"
>
  <span class="tool-icon-badge__shine"></span>
  <span class="tool-icon-badge__floor"></span>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.25"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="tool-icon-badge__svg"
    set:html={toolIconPaths[icon]}
  />
</span>

<style>
  .tool-icon-badge {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.7rem;
    transform: translateZ(0);
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white 55%, transparent),
      inset 0 -2px 0 color-mix(in oklab, black 12%, transparent),
      0 1px 2px color-mix(in oklab, black 8%, transparent),
      0 6px 14px color-mix(in oklab, black 14%, transparent);
  }

  .tool-icon-badge--sm {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.6rem;
  }

  .tool-icon-badge__shine {
    position: absolute;
    inset: 1px 2px auto;
    height: 46%;
    border-radius: 0.55rem 0.55rem 45% 45%;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, white 62%, transparent) 0%,
      transparent 100%
    );
    pointer-events: none;
  }

  .tool-icon-badge--sm .tool-icon-badge__shine {
    border-radius: 0.45rem 0.45rem 45% 45%;
  }

  .tool-icon-badge__floor {
    position: absolute;
    inset: auto 3px 2px;
    height: 3px;
    border-radius: 999px;
    background: color-mix(in oklab, black 18%, transparent);
    filter: blur(2px);
    opacity: 0.35;
    pointer-events: none;
  }

  .tool-icon-badge__svg {
    position: relative;
    z-index: 1;
    width: 0.95rem;
    height: 0.95rem;
    color: white;
    filter: drop-shadow(0 1px 1px color-mix(in oklab, black 28%, transparent));
  }

  .tool-icon-badge--sm .tool-icon-badge__svg {
    width: 0.82rem;
    height: 0.82rem;
  }

  :global(.dark) .tool-icon-badge {
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white 16%, transparent),
      inset 0 -2px 0 color-mix(in oklab, black 28%, transparent),
      0 4px 12px color-mix(in oklab, black 35%, transparent);
  }

  .tool-icon-badge--compress {
    background: linear-gradient(145deg, #c4b5fd 0%, #8b5cf6 42%, #6d28d9 100%);
  }

  .tool-icon-badge--convert {
    background: linear-gradient(145deg, #a5b4fc 0%, #6366f1 45%, #4338ca 100%);
  }

  .tool-icon-badge--merge {
    background: linear-gradient(145deg, #93c5fd 0%, #3b82f6 45%, #1d4ed8 100%);
  }

  .tool-icon-badge--split {
    background: linear-gradient(145deg, #7dd3fc 0%, #0ea5e9 45%, #0369a1 100%);
  }

  .tool-icon-badge--rotate {
    background: linear-gradient(145deg, #67e8f9 0%, #06b6d4 45%, #0e7490 100%);
  }

  .tool-icon-badge--delete {
    background: linear-gradient(145deg, #fda4af 0%, #f43f5e 45%, #be123c 100%);
  }

  .tool-icon-badge--edit {
    background: linear-gradient(145deg, #fcd34d 0%, #f59e0b 45%, #b45309 100%);
  }

  .tool-icon-badge--reader {
    background: linear-gradient(145deg, #fdba74 0%, #f97316 45%, #c2410c 100%);
  }

  .tool-icon-badge--number {
    background: linear-gradient(145deg, #bef264 0%, #84cc16 45%, #4d7c0f 100%);
  }

  .tool-icon-badge--crop {
    background: linear-gradient(145deg, #6ee7b7 0%, #10b981 45%, #047857 100%);
  }

  .tool-icon-badge--watermark {
    background: linear-gradient(145deg, #5eead4 0%, #14b8a6 45%, #0f766e 100%);
  }

  .tool-icon-badge--pdf-word {
    background: linear-gradient(145deg, #93c5fd 0%, #2563eb 45%, #1e40af 100%);
  }

  .tool-icon-badge--pdf-excel {
    background: linear-gradient(145deg, #86efac 0%, #22c55e 45%, #15803d 100%);
  }

  .tool-icon-badge--pdf-ppt {
    background: linear-gradient(145deg, #fdba74 0%, #ea580c 45%, #9a3412 100%);
  }

  .tool-icon-badge--pdf-jpg {
    background: linear-gradient(145deg, #f9a8d4 0%, #ec4899 45%, #be185d 100%);
  }

  .tool-icon-badge--word-pdf {
    background: linear-gradient(145deg, #93c5fd 0%, #2563eb 45%, #1e3a8a 100%);
  }

  .tool-icon-badge--excel-pdf {
    background: linear-gradient(145deg, #86efac 0%, #16a34a 45%, #166534 100%);
  }

  .tool-icon-badge--ppt-pdf {
    background: linear-gradient(145deg, #fdba74 0%, #f97316 45%, #9a3412 100%);
  }

  .tool-icon-badge--jpg-pdf {
    background: linear-gradient(145deg, #f0abfc 0%, #d946ef 45%, #a21caf 100%);
  }

  .tool-icon-badge--sign {
    background: linear-gradient(145deg, #c4b5fd 0%, #9333ea 45%, #6b21a8 100%);
  }

  .tool-icon-badge--unlock {
    background: linear-gradient(145deg, #fde047 0%, #eab308 45%, #a16207 100%);
  }

  .tool-icon-badge--protect {
    background: linear-gradient(145deg, #fca5a5 0%, #ef4444 45%, #b91c1c 100%);
  }
</style>
