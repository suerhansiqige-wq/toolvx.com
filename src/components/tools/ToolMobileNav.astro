---
import { getRelativeLocaleUrl } from "astro:i18n";
import ToolIconBadge from "@/components/tools/ToolIconBadge.astro";
import {
  buildFlatToolSidebarItems,
  isToolPathActive,
} from "@/data/toolSidebar";

const currentPath = Astro.url.pathname;
const items = buildFlatToolSidebarItems(slug =>
  getRelativeLocaleUrl("en", `tools/${slug}`)
);
---

<nav
  class="tool-mobile-nav lg:hidden"
  aria-label="PDF tools"
  data-i18n-aria-label="site.sidebar.ariaLabel"
  data-pagefind-ignore
>
  <div class="tool-mobile-nav__scroll" tabindex="-1">
    {
      items.map(item => {
        const active = isToolPathActive(currentPath, item.href);
        return (
          <a
            href={item.href}
            class:list={[
              "tool-mobile-nav__chip",
              active && "tool-mobile-nav__chip--active",
            ]}
            aria-current={active ? "page" : undefined}
          >
            <ToolIconBadge icon={item.icon} size="sm" />
            <span
              class="tool-mobile-nav__label"
              data-i18n={`menu.tools.${item.i18nKey}`}
            >
              {item.label}
            </span>
          </a>
        );
      })
    }
  </div>
</nav>

<script>
  function scrollActiveToolChipIntoView() {
    const active = document.querySelector<HTMLElement>(
      ".tool-mobile-nav__chip--active"
    );
    active?.scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" });
  }

  scrollActiveToolChipIntoView();
  document.addEventListener("astro:page-load", scrollActiveToolChipIntoView);
</script>

<style>
  .tool-mobile-nav {
    margin-bottom: 1rem;
    margin-inline: calc(-1 * var(--layout-gutter));
  }

  .tool-mobile-nav__scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    padding-block: 0.125rem 0.375rem;
    padding-inline: var(--layout-gutter);
  }

  .tool-mobile-nav__scroll::-webkit-scrollbar {
    display: none;
  }

  .tool-mobile-nav__chip {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.45rem;
    scroll-snap-align: start;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklab, var(--border) 88%, transparent);
    background: color-mix(in oklab, var(--card) 92%, var(--muted) 8%);
    padding: 0.45rem 0.8rem 0.45rem 0.55rem;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--foreground);
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 0.18s ease,
      background-color 0.18s ease,
      color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .tool-mobile-nav__chip:hover {
    border-color: color-mix(in oklab, var(--accent) 35%, transparent);
    background: color-mix(in oklab, var(--accent) 8%, var(--card));
    color: var(--accent);
  }

  .tool-mobile-nav__chip--active {
    border-color: color-mix(in oklab, var(--accent) 45%, transparent);
    background: color-mix(in oklab, var(--accent) 12%, var(--card));
    color: var(--accent);
    font-weight: 600;
    box-shadow: 0 2px 10px color-mix(in oklab, var(--accent) 16%, transparent);
  }

  .tool-mobile-nav__label {
    max-width: 8.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
