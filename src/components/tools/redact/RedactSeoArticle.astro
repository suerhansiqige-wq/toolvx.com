---
import type { RedactToolSEO } from "@/data/redactToolSeo";

type Props = {
  seo: RedactToolSEO;
  class?: string;
};

const { seo, class: className } = Astro.props;
const stepsId = "redact-guide-steps";
const featuresId = "redact-guide-features";
const faqId = "redact-guide-faq";
---

<section
  id="redact-seo-article"
  class:list={[
    "redact-seo-article border-border mx-auto mt-10 max-w-4xl border-t pt-10",
    className,
  ]}
  aria-labelledby={stepsId}
  data-pagefind-body
>
  <div class="bg-muted/40 mb-10 rounded-2xl p-6 sm:p-8">
    <h2
      id={stepsId}
      class="text-foreground mb-4 text-2xl font-semibold tracking-tight sm:text-3xl"
      data-i18n="redact.stepsHeading"
    >
      {seo.stepsHeading}
    </h2>
    <ol class="text-muted-foreground list-decimal space-y-3 ps-6 text-base leading-relaxed">
      {
        seo.steps.map((step, index) => (
          <li class="text-foreground/90" data-i18n={`redact.step.${index}`}>
            {step}
          </li>
        ))
      }
    </ol>
  </div>

  <div class="mb-10">
    <h2
      id={featuresId}
      class="text-foreground mb-6 text-2xl font-semibold tracking-tight sm:text-3xl"
      data-i18n="redact.featuresHeading"
    >
      {seo.featuresHeading}
    </h2>
    <ul class="grid gap-6 sm:grid-cols-1 lg:gap-8" role="list">
      {
        seo.features.map((feature, index) => (
          <li class="border-border bg-muted/30 flex gap-4 rounded-2xl border p-5 sm:p-6">
            <div
              class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-xl"
              role="img"
              aria-label={feature.iconAlt}
            >
              {index === 0 && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="size-5"
                  aria-hidden="true"
                >
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
              )}
              {index === 1 && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="size-5"
                  aria-hidden="true"
                >
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
              )}
              {index === 2 && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="size-5"
                  aria-hidden="true"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" />
                </svg>
              )}
            </div>
            <div class="min-w-0">
              <h3
                class="text-foreground mb-2 text-lg font-semibold tracking-tight"
                data-i18n={`redact.${feature.titleKey}`}
              >
                {feature.title}
              </h3>
              <p
                class="text-muted-foreground text-base leading-relaxed"
                data-i18n={`redact.${feature.bodyKey}`}
              >
                {feature.body}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="space-y-8">
    <h2
      id={faqId}
      class="text-foreground text-2xl font-semibold tracking-tight sm:text-3xl"
      data-i18n="redact.faqHeading"
    >
      {seo.faqHeading}
    </h2>

    {
      seo.faqs.map(faq => (
        <div class="border-border border-b pb-8 last:border-b-0 last:pb-0">
          <h3
            class="text-foreground mb-3 text-lg font-semibold tracking-tight sm:text-xl"
            data-i18n={`redact.${faq.qKey}`}
          >
            {faq.question}
          </h3>
          <p
            class="text-muted-foreground border-accent/60 border-s-2 ps-4 text-base leading-relaxed"
            data-i18n={`redact.${faq.aKey}`}
          >
            {faq.answer}
          </p>
        </div>
      ))
    }
  </div>
</section>
