---
/** Three-column image & PDF redaction workspace — polished standalone UI. */
---

<div id="redact-root" class="redact-root">
  <input
    type="file"
    id="redact-file-input"
    accept="image/jpeg,image/png,image/gif,image/webp,.jpg,.jpeg,.png,.gif,.webp,.pdf,application/pdf"
    class="file-input-native-hidden"
  />

  <!-- Homepage: centered upload (Fig.1 → Fig.3) -->
  <section id="redact-home" class="redact-home" data-i18n-aria-label="redact_home_aria">
    <label
      id="redact-empty"
      for="redact-file-input"
      class="redact-empty-zone redact-dropzone interactive"
    >
      <div class="redact-empty-zone__glow" aria-hidden="true"></div>
      <div class="redact-empty-zone__icon" aria-hidden="true">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.75"
            d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
          ></path>
        </svg>
      </div>
      <p class="redact-empty-zone__title" data-i18n="redact_drop_title">Drop your file here</p>
      <p class="redact-empty-zone__subtitle" data-i18n="redact_drop_subtitle">
        or click to browse files
      </p>
      <p id="redact-loading-hint" class="redact-empty-zone__loading hidden" data-i18n="processing">
        Processing…
      </p>
      <div class="redact-format-tags" aria-hidden="true">
        <span data-i18n="redact_format_jpg">JPG</span>
        <span data-i18n="redact_format_png">PNG</span>
        <span data-i18n="redact_format_gif">GIF</span>
        <span data-i18n="redact_format_webp">WebP</span>
        <span data-i18n="redact_format_pdf">PDF</span>
      </div>
      <p class="sr-only" data-i18n="redact_drop_formats">Supports JPG, PNG, GIF, WebP, PDF</p>
    </label>
  </section>

  <!-- Editor: shown after file is loaded -->
  <div id="redact-editor" class="redact-editor hidden" data-i18n-aria-label="redact_editor_mode">
  <div class="redact-grid grid gap-5 lg:grid-cols-12 lg:gap-6">
    <!-- Left: open file + PDF thumbnails -->
    <div class="redact-left-column flex min-w-0 flex-col gap-3 lg:col-span-2">
      <label
        id="redact-floating-upload"
        for="redact-file-input"
        class="redact-open-file redact-dropzone hidden"
      >
        <span class="redact-open-file__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
          </svg>
        </span>
        <span class="redact-open-file__text" data-i18n="redact_float_title">Open another file</span>
      </label>

      <aside id="redact-thumb-sidebar" class="redact-thumb-panel card-surface hidden w-full lg:block">
        <div class="redact-panel-head">
          <span class="redact-panel-head__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </span>
          <h3 class="redact-panel-head__title" data-i18n="redact_pages_title">Pages</h3>
        </div>
        <div id="redact-thumb-list" class="redact-thumb-list"></div>
        <div id="redact-thumb-pagination" class="redact-thumb-pagination hidden">
          <button
            type="button"
            id="redact-thumb-prev"
            class="redact-icon-btn interactive"
            data-i18n-aria-label="common.prevPage"
          >
            ←
          </button>
          <span id="redact-thumb-info" class="redact-thumb-pagination__info"></span>
          <button
            type="button"
            id="redact-thumb-next"
            class="redact-icon-btn interactive"
            data-i18n-aria-label="common.nextPage"
          >
            →
          </button>
        </div>
      </aside>
    </div>

    <!-- Center: canvas -->
    <div class="redact-canvas-column min-w-0 space-y-4 lg:col-span-7">
      <div id="redact-canvas-wrap" class="redact-canvas-wrap card-surface hidden">
        <div id="redact-canvas-stage" class="redact-canvas-stage">
          <div id="redact-canvas-inner" class="redact-canvas-inner">
            <canvas id="redact-canvas" class="redact-canvas block touch-none"></canvas>
            <canvas
              id="redact-overlay"
              class="redact-overlay pointer-events-none absolute left-0 top-0 touch-none"
            ></canvas>
          </div>
        </div>
      </div>

      <div id="redact-page-controls" class="redact-page-bar card-surface hidden">
        <button
          type="button"
          id="redact-prev-page"
          class="redact-nav-btn tool-action-btn interactive"
          data-i18n="common.prevPage"
        >
          Previous
        </button>
        <span class="redact-page-indicator">
          <span data-i18n="redact_page_label">Page</span>
          <span id="redact-page-current" class="redact-page-indicator__num">1</span>
          <span data-i18n="redact_page_of">of</span>
          <span id="redact-page-total" class="redact-page-indicator__num">1</span>
        </span>
        <button
          type="button"
          id="redact-next-page"
          class="redact-nav-btn tool-action-btn interactive"
          data-i18n="common.nextPage"
        >
          Next
        </button>
      </div>
    </div>

    <!-- Right: controls -->
    <aside id="redact-control-panel" class="redact-controls space-y-4 lg:col-span-3 lg:sticky lg:top-24 lg:self-start">
      <div class="redact-panel card-surface">
        <div class="redact-panel-head">
          <span class="redact-panel-head__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </span>
          <label class="redact-panel-head__title" data-i18n="redact_color_label">Fill Color</label>
        </div>
        <div class="redact-color-actions">
          <div id="redact-color-preview" class="redact-color-preview" aria-hidden="true"></div>
          <button type="button" id="redact-clear-color" class="redact-btn-ghost interactive" data-i18n="redact_color_clear">
            Clear Color
          </button>
        </div>
        <div id="redact-color-palette" class="redact-color-grid" role="listbox"></div>
      </div>

      <div id="redact-history" class="hidden">
        <div class="redact-history-row">
          <button type="button" id="redact-undo" class="redact-btn-secondary interactive" disabled data-i18n="redact_undo">
            Undo
          </button>
          <button type="button" id="redact-redo" class="redact-btn-primary tool-action-btn interactive" disabled data-i18n="redact_redo">
            Redo
          </button>
        </div>
      </div>

      <div id="redact-effects" class="redact-panel card-surface hidden">
        <div class="redact-panel-head">
          <span class="redact-panel-head__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
          </span>
          <label for="redact-effect-type" class="redact-panel-head__title" data-i18n="redact_effect_label">
            Effect Type
          </label>
        </div>
        <select id="redact-effect-type" class="redact-select">
          <option value="pixelate" data-i18n="redact_effect_mosaic">Mosaic (Pixelate)</option>
          <option value="blur" data-i18n="redact_effect_blur">Gaussian Blur</option>
          <option value="blackout" data-i18n="redact_effect_blackout">Solid Fill (Blackout)</option>
        </select>

        <div class="redact-slider-group">
          <label for="redact-mosaic-size" class="redact-slider-label">
            <span data-i18n="redact_mosaic_label">Mosaic size</span>
            <span class="redact-slider-value"><span id="redact-mosaic-value">12</span><span data-i18n="redact_unit_px">px</span></span>
          </label>
          <input type="range" id="redact-mosaic-size" min="4" max="40" value="12" class="redact-range" />
        </div>

        <div class="redact-slider-group">
          <label for="redact-blur-radius" class="redact-slider-label">
            <span data-i18n="redact_blur_label">Blur radius</span>
            <span class="redact-slider-value"><span id="redact-blur-value">14</span><span data-i18n="redact_unit_px">px</span></span>
          </label>
          <input type="range" id="redact-blur-radius" min="4" max="40" value="14" class="redact-range" />
        </div>

        <p class="redact-hint" data-i18n="redact_select_hint">
          Drag on the image to select an area. Mosaic and blur apply instantly; blackout uses the fill color above.
        </p>

        <button type="button" id="redact-reset" class="redact-btn-danger interactive" data-i18n="redact_reset">
          Reset to Original
        </button>
      </div>

      <button type="button" id="redact-export-btn" class="redact-btn-export tool-action-btn interactive hidden">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span data-i18n="redact_export">Download Redacted File</span>
      </button>
    </aside>
  </div>
  </div>
</div>

<style>
  .redact-root {
    --redact-radius: 1rem;
    --redact-radius-lg: 1.25rem;
    width: 100%;
    margin-inline: auto;
  }

  #redact-home.hidden,
  #redact-editor.hidden,
  #redact-canvas-wrap.hidden {
    display: none !important;
  }

  /* —— Homepage (centered upload) —— */
  .redact-home {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 0 0 2rem;
    transition:
      opacity 0.28s ease,
      transform 0.28s ease;
  }

  .redact-home--leaving {
    opacity: 0;
    transform: translateY(-12px) scale(0.98);
    pointer-events: none;
  }

  .redact-home .redact-empty-zone {
    width: 100%;
    max-width: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  /* —— Editor shell —— */
  .redact-editor {
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    animation: redact-editor-in 0.38s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes redact-editor-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* —— Open file (above thumbnails) —— */
  .redact-open-file {
    display: flex;
    width: 100%;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--redact-radius-lg);
    border: 3px dashed #818cf8;
    background: linear-gradient(145deg, #eef2ff 0%, #ffffff 100%);
    padding: 0.875rem 0.75rem;
    text-align: center;
    box-shadow:
      0 0 0 1px rgba(99, 102, 241, 0.12),
      0 6px 18px rgba(79, 70, 229, 0.1);
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  :global([data-theme="dark"]) .redact-open-file,
  :global(.dark) .redact-open-file {
    border-color: #22d3ee;
    background: linear-gradient(145deg, #0c4a6e 0%, #111827 100%);
    box-shadow:
      0 0 0 1px rgba(34, 211, 238, 0.3),
      0 6px 20px rgba(6, 182, 212, 0.18);
  }

  .redact-open-file:hover {
    border-color: #4f46e5;
    background: #eef2ff;
    transform: translateY(-1px);
    box-shadow:
      0 0 0 2px rgba(99, 102, 241, 0.22),
      0 10px 24px rgba(79, 70, 229, 0.16);
  }

  :global([data-theme="dark"]) .redact-open-file:hover,
  :global(.dark) .redact-open-file:hover {
    border-color: #67e8f9;
    background: #164e63;
    box-shadow:
      0 0 0 2px rgba(34, 211, 238, 0.35),
      0 10px 26px rgba(34, 211, 238, 0.22);
  }

  .redact-open-file__icon {
    display: flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    background: #c7d2fe;
    color: #4338ca;
  }

  :global([data-theme="dark"]) .redact-open-file__icon,
  :global(.dark) .redact-open-file__icon {
    background: #155e75;
    color: #67e8f9;
  }

  .redact-open-file__icon svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .redact-open-file__text {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--foreground);
  }

  @media (min-width: 640px) {
    .redact-open-file {
      flex-direction: row;
      text-align: left;
      padding: 0.75rem 0.875rem;
    }
  }

  /* —— Panels —— */
  .redact-panel,
  .redact-thumb-panel {
    border-radius: var(--redact-radius-lg);
    padding: 1rem;
    box-shadow: var(--shadow-ambient);
  }

  .redact-panel-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 80%, transparent);
  }

  .redact-panel-head__icon {
    display: flex;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--accent) 12%, transparent);
    color: var(--accent);
  }

  .redact-panel-head__icon svg {
    width: 1rem;
    height: 1rem;
  }

  .redact-panel-head__title {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }

  /* —— Thumbnails —— */
  #redact-thumb-sidebar.redact-thumb-active {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .redact-thumb-list {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.25rem;
    min-height: 0;
    overflow: hidden;
  }

  .redact-thumb-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .redact-thumb-pagination__info {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }

  .redact-icon-btn {
    display: inline-flex;
    min-width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: var(--card);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--accent);
  }

  .redact-icon-btn:hover:not(:disabled) {
    border-color: var(--accent);
    background: color-mix(in oklab, var(--accent) 8%, var(--card));
  }

  .redact-icon-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* —— Canvas (no outer frame) —— */
  .redact-canvas-column {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    gap: 1rem;
  }

  .redact-canvas-wrap {
    display: flex;
    flex-direction: column;
    position: relative;
    width: 100%;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--redact-radius);
    padding: 0.75rem 1rem;
  }

  .redact-canvas-stage {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 100%;
    min-height: 0;
    line-height: 0;
  }

  .redact-canvas-inner {
    position: relative;
    width: 100%;
    line-height: 0;
    box-shadow: 0 2px 16px color-mix(in oklab, black 10%, transparent);
  }

  .redact-canvas {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0.125rem;
    background: #fff;
  }

  /* —— Page navigation —— */
  .redact-page-bar {
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1rem;
    border-radius: var(--redact-radius);
    padding: 0.75rem 1rem;
    text-align: center;
  }

  .redact-nav-btn {
    border-radius: 0.625rem;
    padding: 0.5rem 1.125rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: white;
  }

  .redact-page-indicator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }

  .redact-page-indicator__num {
    font-weight: 700;
    color: var(--accent);
  }

  /* —— Empty state —— */
  .redact-empty-zone {
    position: relative;
    cursor: pointer;
    overflow: hidden;
    border-radius: var(--redact-radius-lg);
    border: 3px dashed #6366f1;
    background: linear-gradient(160deg, #eef2ff 0%, #ffffff 48%, #f8fafc 100%);
    padding: 3rem 1.5rem;
    text-align: center;
    box-shadow:
      0 0 0 1px rgba(99, 102, 241, 0.18),
      0 10px 28px rgba(79, 70, 229, 0.14);
    transition:
      border-color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  :global([data-theme="dark"]) .redact-empty-zone,
  :global(.dark) .redact-empty-zone {
    border-color: #22d3ee;
    background: linear-gradient(160deg, #083344 0%, #111827 48%, #0b0f19 100%);
    box-shadow:
      0 0 0 1px rgba(34, 211, 238, 0.4),
      0 10px 32px rgba(6, 182, 212, 0.22);
  }

  @media (min-width: 640px) {
    .redact-empty-zone {
      padding: 4rem 2rem;
    }
  }

  .redact-empty-zone:hover {
    border-color: #4f46e5;
    transform: translateY(-2px);
    box-shadow:
      0 0 0 2px rgba(99, 102, 241, 0.28),
      0 14px 36px rgba(79, 70, 229, 0.22);
  }

  :global([data-theme="dark"]) .redact-empty-zone:hover,
  :global(.dark) .redact-empty-zone:hover {
    border-color: #67e8f9;
    box-shadow:
      0 0 0 2px rgba(34, 211, 238, 0.45),
      0 14px 40px rgba(34, 211, 238, 0.28);
  }

  .redact-empty-zone__glow {
    pointer-events: none;
    position: absolute;
    inset: -40% auto auto 50%;
    width: 70%;
    height: 70%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.2) 0%, transparent 70%);
    opacity: 0.75;
  }

  :global([data-theme="dark"]) .redact-empty-zone__glow,
  :global(.dark) .redact-empty-zone__glow {
    background: radial-gradient(circle, rgba(34, 211, 238, 0.28) 0%, transparent 70%);
  }

  .redact-empty-zone__icon {
    position: relative;
    display: flex;
    width: 4.5rem;
    height: 4.5rem;
    margin: 0 auto 1.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 1.25rem;
    background: linear-gradient(145deg, #c7d2fe 0%, #e0e7ff 100%);
    color: #4338ca;
    box-shadow: 0 8px 24px rgba(79, 70, 229, 0.22);
    border: 2px solid #a5b4fc;
  }

  :global([data-theme="dark"]) .redact-empty-zone__icon,
  :global(.dark) .redact-empty-zone__icon {
    background: linear-gradient(145deg, #155e75 0%, #0e7490 100%);
    color: #a5f3fc;
    border-color: #22d3ee;
    box-shadow: 0 8px 24px rgba(6, 182, 212, 0.35);
  }

  .redact-empty-zone__icon svg {
    width: 2.25rem;
    height: 2.25rem;
  }

  .redact-empty-zone__title {
    position: relative;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }

  .redact-empty-zone__subtitle {
    position: relative;
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--muted-foreground);
  }

  .redact-format-tags {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.375rem;
    margin-top: 1.25rem;
  }

  .redact-format-tags span {
    border-radius: 9999px;
    border: 1px solid color-mix(in oklab, var(--accent) 25%, var(--border));
    background: color-mix(in oklab, var(--accent) 6%, var(--card));
