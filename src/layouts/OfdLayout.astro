---
import Layout from "./Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import OfdMobileNav from "@/components/ofd/OfdMobileNav.astro";
import OfdSidebarNav from "@/components/ofd/OfdSidebarNav.astro";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import config from "@/config";
import type { FAQItem } from "@/data/toolsSeo";

type Props = {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  canonicalURL?: string;
  appName?: string;
  faqs?: FAQItem[];
  steps?: string[];
};

const {
  title,
  description,
  keywords,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  appName,
  faqs = [],
  steps = [],
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: appName ?? title.split("|")[0]?.trim() ?? title,
  description,
  url: canonicalURL,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  inLanguage: "en",
};

const faqStructuredData =
  faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map(faq => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: faq.answer,
          },
        })),
      }
    : null;

const howToStructuredData =
  steps.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "HowTo",
        name: `How to use ${appName ?? "this OFD tool"}`,
        description,
        step: steps.map((text, index) => ({
          "@type": "HowToStep",
          position: index + 1,
          text,
        })),
      }
    : null;
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <Fragment slot="head">
    {keywords && <meta name="keywords" content={keywords} />}
    <meta property="og:locale" content="en_US" />
    <meta name="language" content="English" />
    <meta name="robots" content="index, follow" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    {
      faqStructuredData && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(faqStructuredData)} />
      )
    }
    {
      howToStructuredData && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(howToStructuredData)} />
      )
    }
    <slot name="head" />
  </Fragment>

  <Header />

  <main id="main-content" class="app-layout flex flex-1 flex-col py-6 sm:py-8">
    <div class="tool-layout-grid flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-8">
      <aside
        class="tool-layout-sidebar hidden min-w-0 overflow-visible lg:block lg:shrink-0"
        data-pagefind-ignore
      >
        <div class="tool-sidebar-scroll sticky top-20 pb-16 pe-3">
          <OfdSidebarNav />
        </div>
      </aside>

      <section class="min-w-0 flex-1" aria-label="OFD tool workspace">
        <OfdMobileNav />
        <slot />
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { syncToolSidebarWidth } from "@/scripts/tool-sidebar-width";

  function initOfdLayout() {
    syncToolSidebarWidth();
  }

  initOfdLayout();
  document.addEventListener("astro:after-swap", initOfdLayout);
</script>
