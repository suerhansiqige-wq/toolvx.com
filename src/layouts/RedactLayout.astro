---
import Layout from "./Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import config from "@/config";
import type { FAQItem } from "@/data/toolsSeo";

type Props = {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  canonicalURL?: string;
  appName?: string;
  faqs?: FAQItem[];
  steps?: string[];
  titleI18n?: string;
  descriptionI18n?: string;
  /** When true, adds noindex (staging only). Production redact page should stay indexable. */
  noIndex?: boolean;
};

const {
  title,
  description,
  keywords,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  appName,
  faqs = [],
  steps = [],
  titleI18n = "redact.seo.title",
  descriptionI18n = "redact.seo.description",
  noIndex = false,
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: appName ?? "PDF & Image Redaction Tool",
  description,
  url: canonicalURL,
  applicationCategory: "BusinessApplication",
  operatingSystem: "All",
  browserRequirements: "Requires JavaScript. Runs entirely in the browser.",
  featureList: [
    "PDF redaction",
    "Image redaction",
    "Blur and mosaic redaction",
    "Solid blackout redaction",
    "Local browser-based processing",
  ],
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  inLanguage: "en",
  isAccessibleForFree: true,
};

const faqStructuredData =
  faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map(faq => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: faq.answer,
          },
        })),
      }
    : null;

const howToStructuredData =
  steps.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "HowTo",
        name: `How to use ${appName ?? "PDF & Image Redaction Tool"}`,
        step: steps.map((text, index) => ({
          "@type": "HowToStep",
          position: index + 1,
          text,
        })),
      }
    : null;
---

<Layout
  {title}
  {description}
  {ogImage}
  {canonicalURL}
  {titleI18n}
  {descriptionI18n}
  robots={noIndex ? "noindex, nofollow" : "index, follow"}
>
  <Fragment slot="head">
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="language" content="English" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    {
      howToStructuredData && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(howToStructuredData)} />
      )
    }
    {
      faqStructuredData && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(faqStructuredData)} />
      )
    }
    <slot name="head" />
  </Fragment>

  <Header />

  <main
    id="main-content"
    class="mx-auto w-full max-w-[1440px] flex-1 px-4 py-6 sm:px-6 sm:py-8"
  >
    <slot />
  </main>

  <Footer noMarginTop />
</Layout>
