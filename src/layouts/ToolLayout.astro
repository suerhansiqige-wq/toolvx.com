---
import Layout from "./Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AdSlot from "@/components/AdSlot.astro";
import ToolSidebarNav from "@/components/tools/ToolSidebarNav.astro";
import ToolMobileNav from "@/components/tools/ToolMobileNav.astro";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import config from "@/config";
import type { FAQItem } from "@/data/toolsSeo";
import type { Locale } from "@/i18n/config";

type Props = {
  /** Full page title for `<title>` and OG tags (50–60 chars recommended). */
  title: string;
  /** Meta description for search snippets (150–160 chars recommended). */
  description: string;
  /** Comma-separated keywords for legacy SEO meta. */
  keywords?: string;
  ogImage?: string;
  canonicalURL?: string;
  /** When true, hides the bottom leaderboard slot. */
  hideBottomAd?: boolean;
  /** FAQ entries for FAQPage JSON-LD (must match visible FAQ content). */
  faqs?: FAQItem[];
  /** Short app name for WebApplication schema. */
  appName?: string;
  /** How-to steps for HowTo JSON-LD (must match visible steps). */
  steps?: string[];
  /** Core feature list for WebApplication JSON-LD schema. */
  features?: string[];
  /** i18n keys for client-side head meta switching. */
  titleI18n?: string;
  descriptionI18n?: string;
  /** Page language for <html lang> and i18n routing. */
  lang?: Locale;
};

const {
  title,
  description,
  keywords,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  hideBottomAd = false,
  faqs = [],
  appName,
  steps = [],
  features = [],
  titleI18n,
  descriptionI18n,
  lang,
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: appName ?? title.split("|")[0]?.trim() ?? title,
  description,
  url: canonicalURL,
  applicationCategory: "BusinessApplication",
  operatingSystem: "All",
  browserRequirements: "Requires JavaScript. Requires HTML5.",
  featureList: features.length > 0 ? features : undefined,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  isAccessibleForFree: true,
  inLanguage: "en",
};

const faqStructuredData =
  faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map(faq => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: faq.answer,
          },
        })),
      }
    : null;

const howToStructuredData =
  steps.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "HowTo",
        name: `How to use ${appName ?? title.split("|")[0]?.trim() ?? title}`,
        step: steps.map((text, index) => ({
          "@type": "HowToStep",
          position: index + 1,
          text,
        })),
      }
    : null;
---

<Layout
  {title}
  {description}
  {ogImage}
  {canonicalURL}
  {titleI18n}
  {descriptionI18n}
  lang={lang}
>
  <Fragment slot="head">
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="language" content="English" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
    {
      howToStructuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(howToStructuredData)}
        />
      )
    }
    {
      faqStructuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(faqStructuredData)}
        />
      )
    }
    <slot name="head" />
  </Fragment>

  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 flex-col py-6 sm:py-8"
  >
    <div class="tool-layout-grid flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-8">
      <!-- Column 1: Tool navigation — width follows menu label length -->
      <aside
        class="tool-layout-sidebar hidden min-w-0 overflow-visible lg:block lg:shrink-0"
        aria-label="Tools sidebar"
        data-i18n-aria-label="blog.layout.toolsSidebar"
        data-pagefind-ignore
      >
        <div class="tool-sidebar-scroll sticky top-20 pb-16 pe-3">
          <ToolSidebarNav />
        </div>
      </aside>

      <!-- Column 2: Core tool workspace -->
      <section
        class="min-w-0 flex-1"
        aria-label="Tool workspace"
        data-i18n-aria-label="blog.layout.toolWorkspace"
      >
        <ToolMobileNav />
        <slot />
      </section>

      <!-- Column 3: AdSense skyscraper (desktop only) -->
      <aside
        class="hidden w-full max-w-[300px] shrink-0 lg:block"
        aria-label="Sidebar advertisement"
        data-i18n-aria-label="blog.layout.sidebarAd"
        data-pagefind-ignore
      >
        <div class="sticky top-24">
          <AdSlot
            variant="skyscraper"
            class="my-0"
            data-ad-position="sidebar-skyscraper"
          />
        </div>
      </aside>
    </div>

    {
      !hideBottomAd && (
        <div class="mt-8 lg:mt-10">
          <AdSlot
            variant="leaderboard"
            class="shrink-0"
            data-ad-position="bottom-leaderboard"
          />
        </div>
      )
    }
  </main>

  <Footer noMarginTop />
</Layout>

<style is:global>
  .tool-sidebar-scroll {
    max-height: calc(100vh - 4.5rem);
    max-height: calc(100dvh - 4.5rem);
    overflow-x: visible;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-padding-block-end: 3rem;
    padding-bottom: 4rem;
  }
</style>
