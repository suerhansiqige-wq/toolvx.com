---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const page = await getEntry("pages", "privacy-policy");
if (!page) throw new Error("Missing content entry: `privacy-policy` in `src/content/pages/`");
const { Content } = await render(page);
---

<Layout
  title={`${page.data.title} | ${config.site.title}`}
  description={page.data.description}
  ogImage={page.data.ogImage}
  canonicalURL={page.data.canonicalURL}
  lang="de"
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={page.data.title} pageTitleI18n="blog.pages.privacyPolicyTitle" pageDesc={page.data.description} pageDescI18n="blog.pages.privacyPolicyDesc" class="app-prose">
    <Content />
  </Main>
  <Footer />
</Layout>
