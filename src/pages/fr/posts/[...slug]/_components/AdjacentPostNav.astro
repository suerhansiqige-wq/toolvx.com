---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
  i18nKey?: string;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div data-pagefind-ignore class="my-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
  {
    prevPost && (() => {
      const titleI18n = prevPost.i18nKey
        ? `posts.redact.${prevPost.i18nKey}.title`
        : undefined;
      return (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
        class="flex w-full gap-1 hover:opacity-75"
      >
        <IconArrowLeft class="inline-block flex-none rtl:rotate-180" />
        <div>
          <span data-i18n="blog.post.previousPost">{t.post.previousPost}</span>
          <div
            class="text-accent/85 text-sm"
            {...(titleI18n ? { "data-i18n": titleI18n } : {})}
          >
            {prevPost.title}
          </div>
        </div>
      </a>
      );
    })()
  }
  {
    nextPost && (() => {
      const titleI18n = nextPost.i18nKey
        ? `posts.redact.${nextPost.i18nKey}.title`
        : undefined;
      return (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
      >
        <div>
          <span data-i18n="blog.post.nextPost">{t.post.nextPost}</span>
          <div
            class="text-accent/85 text-sm"
            {...(titleI18n ? { "data-i18n": titleI18n } : {})}
          >
            {nextPost.title}
          </div>
        </div>
        <IconArrowRight class="inline-block flex-none rtl:rotate-180" />
      </a>
      );
    })()
  }
</div>
