---
import { getSortedRenderablePosts } from "@/utils/getRenderablePosts";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import HomeToolTags from "@/components/HomeToolTags.astro";
import HomeRedactGuides from "@/components/HomeRedactGuides.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getSortedRenderablePosts();
const featuredPosts = posts.filter(({ data }) => data.featured);
const recentPosts = posts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout pb-16 pt-6 sm:pb-24 sm:pt-10"
  >
    <HomeToolTags locale={locale} />
    <HomeRedactGuides locale={locale} />

    <section
      id="hero"
      class="card-surface shadow-elevated mb-16 p-8 sm:mb-20 sm:p-12 lg:p-16"
    >
      <div class="flex flex-wrap items-start justify-between gap-4">
        <h1
          class="from-accent to-accent/60 bg-gradient-to-r bg-clip-text text-4xl font-bold tracking-tight text-transparent sm:text-5xl lg:text-6xl"
          data-i18n="blog.hero.title"
        >
          Mingalaba
        </h1>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="interactive hover-lift card-surface inline-flex items-center justify-center rounded-xl p-3"
          aria-label="RSS Feed"
          title="RSS Feed"
          data-i18n-aria-label="blog.hero.rssFeed"
          data-i18n-title="blog.hero.rssFeed"
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only" data-i18n="blog.hero.rssFeed">RSS Feed</span>
        </a>
      </div>

      <p
        class="text-muted-foreground mt-8 max-w-3xl text-base leading-relaxed sm:text-lg"
        data-i18n="blog.hero.description"
      >
        AstroPaper is a minimal, responsive, accessible and SEO-friendly Astro
        blog theme. This theme follows best practices and provides accessibility
        out of the box. Light and dark mode are supported by default. Moreover,
        additional color schemes can also be configured.
      </p>
      <p class="text-muted-foreground mt-4 max-w-3xl text-base leading-relaxed">
        <span data-i18n="blog.hero.readPostsPrefix">Read the blog posts or check</span>
        {" "}
        <LinkButton
          class="text-accent underline decoration-dashed underline-offset-4"
          href="https://github.com/satnaing/astro-paper#readme"
        >
          <span data-i18n="blog.hero.readme">README</span>
        </LinkButton>
        {" "}
        <span data-i18n="blog.hero.readPostsSuffix">for more info.</span>
      </p>
      {
        socials.length > 0 && (
          <div class="mt-8 flex max-sm:flex-col sm:items-center sm:gap-3">
            <div
              class="text-muted-foreground me-2 mb-2 whitespace-nowrap sm:mb-0"
              data-i18n="blog.home.socialLinks"
            >
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="mb-16 sm:mb-20">
          <h2
            class="text-foreground mb-8 text-2xl font-bold tracking-tight sm:text-3xl"
            data-i18n="blog.home.featured"
          >
            {t.home.featured}
          </h2>
          <ul class="post-grid list-none p-0">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="mb-12">
          <h2
            class="text-foreground mb-8 text-2xl font-bold tracking-tight sm:text-3xl"
            data-i18n="blog.home.recentPosts"
          >
            {t.home.recentPosts}
          </h2>
          <ul class="post-grid list-none p-0">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="mt-12 text-center">
      <LinkButton
        variant="button"
        href={getRelativeLocaleUrl(locale, "posts")}
      >
        <span data-i18n="blog.home.allPosts">{t.home.allPosts}</span>
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
