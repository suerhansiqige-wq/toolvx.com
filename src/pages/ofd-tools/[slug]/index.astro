---
import OfdToolPage from "@/components/ofd/OfdToolPage.astro";
import {
  DEFAULT_OFD_TOOL_SLUG,
  getOfdToolBySlug,
  ofdToolsRegistry,
} from "@/data/ofdToolsRegistry";
import { getOfdToolSeo } from "@/data/ofdToolsSeo";
import config from "@/config";

/** Static route at `ofd-to-pdf.astro` owns `/ofd-tools/ofd-to-pdf`. */
const STATIC_PAGE_SLUGS = new Set(["ofd-to-pdf"]);

export function getStaticPaths() {
  return ofdToolsRegistry
    .filter(tool => !STATIC_PAGE_SLUGS.has(tool.slug))
    .map(tool => ({
      params: { slug: tool.slug },
      props: { tool },
    }));
}

const { tool } = Astro.props;

if (!getOfdToolBySlug(tool.slug) || !getOfdToolSeo(tool.slug)) {
  return Astro.redirect(`/ofd-tools/${DEFAULT_OFD_TOOL_SLUG}/`);
}

const locale = Astro.currentLocale ?? config.site.lang;
---

<OfdToolPage tool={tool} locale={locale} />
