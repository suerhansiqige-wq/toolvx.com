---
import OfdLayout from "@/layouts/OfdLayout.astro";
import OfdWorkspace from "@/components/ofd/OfdWorkspace.astro";
import { getOfdToolBySlug, ofdToolsRegistry } from "@/data/ofdToolsRegistry";
import { catalogs, type LocaleCode } from "@/i18n/messages";
import config from "@/config";

export function getStaticPaths() {
  return ofdToolsRegistry.map(tool => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const catalog = catalogs[locale as LocaleCode] ?? catalogs.en;
const copy = catalog.ofd.tools[tool.i18nKey as keyof typeof catalog.ofd.tools];

if (!getOfdToolBySlug(tool.slug)) {
  return Astro.redirect("/ofd-tools");
}

const pageTitle = `${copy.title} | ${config.site.title}`;
const pageDescription = `${copy.desc} — 100% local browser processing on ToolVX.`;
const keywords = `OFD, ${copy.title}, OFD tool, browser OFD, ToolVX`;
---

<OfdLayout
  title={pageTitle}
  description={pageDescription}
  keywords={keywords}
  appName={copy.title}
>
  <OfdWorkspace tool={tool} locale={locale} />
</OfdLayout>
