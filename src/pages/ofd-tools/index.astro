---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import OfdToolHubGrid from "@/components/ofd/OfdToolHubGrid.astro";
import { catalogs, type LocaleCode } from "@/i18n/messages";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const catalog = catalogs[locale as LocaleCode] ?? catalogs.en;
const hub = catalog.ofd.hub;

const pageTitle = `${hub.title} | ${config.site.title}`;
const pageDescription = hub.description;
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main id="main-content" class="app-layout pb-16 pt-6 sm:pb-24 sm:pt-10">
    <section class="mb-8 sm:mb-10">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-3xl">
          <p
            class="text-accent mb-2 text-sm font-semibold tracking-wide uppercase"
            data-i18n="ofd.hub.localBadge"
          >
            {hub.localBadge}
          </p>
          <h1
            class="text-foreground text-3xl font-bold tracking-tight sm:text-4xl"
            data-i18n="ofd.hub.title"
          >
            {hub.title}
          </h1>
          <p
            class="text-muted-foreground mt-3 text-base leading-relaxed sm:text-lg"
            data-i18n="ofd.hub.description"
          >
            {hub.description}
          </p>
        </div>
      </div>

      <OfdToolHubGrid locale={locale} />
    </section>
  </main>
  <Footer />
</Layout>
