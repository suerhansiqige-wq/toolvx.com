---
/**
 * OFD → PDF tool page — reference implementation of the standardized
 * SEO + AdSense + FAQ schema template. Other tools use the same layout
 * via `OfdToolPage.astro` from `[slug]/index.astro`.
 */
import OfdToolPage from "@/components/ofd/OfdToolPage.astro";
import { getOfdToolBySlug } from "@/data/ofdToolsRegistry";
import config from "@/config";

const tool = getOfdToolBySlug("ofd-to-pdf");
if (!tool) {
  return Astro.redirect("/ofd-tools/ofd-to-pdf/");
}

const locale = Astro.currentLocale ?? config.site.lang;
---

<OfdToolPage tool={tool} locale={locale} />
