---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import {
  menuColumnOrder,
  toolsRegistry,
} from "@/data/toolsRegistry";
import { getSortedRenderablePosts } from "@/utils/getRenderablePosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getMenuLabel, getColumnTitle } from "@/i18n/server";
import { useTranslations } from "@/i18n";
import { catalogs, resolveLocale } from "@/i18n/messages";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const ofdToolEntries = [
  { slug: "ofd-to-pdf", i18nKey: "ofdToPdf" },
  { slug: "ofd-merge", i18nKey: "ofdMerge" },
  { slug: "ofd-to-image", i18nKey: "ofdToImage" },
  { slug: "ofd-to-svg", i18nKey: "ofdToSvg" },
  { slug: "ofd-to-web", i18nKey: "ofdToWeb" },
  { slug: "ofd-to-text", i18nKey: "ofdToText" },
  { slug: "ofd-compress", i18nKey: "ofdCompress" },
  { slug: "ofd-reader", i18nKey: "ofdReader" },
  { slug: "ofd-to-long-image", i18nKey: "ofdToLongImage" },
] as const;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const catalog = catalogs[resolveLocale(locale)] ?? catalogs.en;
const sm = catalog.blog.sitemap;

const posts = await getSortedRenderablePosts();
const tags = getUniqueTags(posts);

const mainPages = [
  { href: getRelativeLocaleUrl(locale, ""), label: t.nav.home, i18n: "site.nav.home" },
  { href: getRelativeLocaleUrl(locale, "posts"), label: t.nav.posts, i18n: "site.nav.posts" },
  { href: getRelativeLocaleUrl(locale, "tags"), label: t.nav.tags, i18n: "site.nav.tags" },
  { href: getRelativeLocaleUrl(locale, "about"), label: t.nav.about, i18n: "site.nav.about" },
  ...(config.features.showArchives !== false
    ? [
        {
          href: getRelativeLocaleUrl(locale, "archives"),
          label: t.nav.archives,
          i18n: "site.nav.archives",
        },
      ]
    : []),
  { href: getRelativeLocaleUrl(locale, "search"), label: t.nav.search, i18n: "site.nav.search" },
  { href: getRelativeLocaleUrl(locale, "converter"), label: sm.converter, i18n: "blog.sitemap.converter" },
  { href: getRelativeLocaleUrl(locale, "privacy-policy"), label: sm.privacyPolicy, i18n: "blog.sitemap.privacyPolicy" },
  { href: getRelativeLocaleUrl(locale, "terms"), label: sm.terms, i18n: "blog.sitemap.terms" },
  { href: getRelativeLocaleUrl(locale, "cookie-policy"), label: sm.cookiePolicy, i18n: "blog.sitemap.cookiePolicy" },
  { href: getRelativeLocaleUrl(locale, "contact"), label: sm.contact, i18n: "blog.sitemap.contact" },
];

const toolGroups = menuColumnOrder.map(column => ({
  column,
  title: getColumnTitle(column),
  titleI18n: `menu.columns.${column}`,
  items: toolsRegistry
    .filter(tool => tool.column === column)
    .map(tool => ({
      href: getRelativeLocaleUrl(locale, `tools/${tool.slug}`),
      label: getMenuLabel(tool.i18nKey),
      i18n: `menu.tools.${tool.i18nKey}`,
    })),
}));

const redactPage = {
  href: getRelativeLocaleUrl(locale, "redact-preview"),
  label: t.nav.redact,
  i18n: "site.nav.redact",
};

const ofdHub = {
  href: getRelativeLocaleUrl(locale, "ofd-tools"),
  label: sm.ofdHub,
  i18n: "blog.sitemap.ofdHub",
};

const ofdTools = ofdToolEntries.map(tool => ({
  href: getRelativeLocaleUrl(locale, `ofd-tools/${tool.slug}`),
  label: sm.ofdItems[tool.i18nKey],
  i18n: `blog.sitemap.ofdItems.${tool.i18nKey}`,
}));

const xmlSitemapUrl = getAssetPath("sitemap-index.xml");
---

<Layout
  title={`${t.pages.sitemapTitle} | ${config.site.title}`}
  robots="noindex, nofollow"
>
  <Header />
  <Breadcrumb />

  <Main
    pageTitle={t.pages.sitemapTitle}
    pageDesc={t.pages.sitemapDesc}
    pageTitleI18n="blog.pages.sitemapTitle"
    pageDescI18n="blog.pages.sitemapDesc"
    class="sm-main"
  >
    <a href={xmlSitemapUrl} class="sm-xml-banner card-surface interactive">
      <span class="sm-xml-banner__icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </span>
      <span class="sm-xml-banner__body">
        <span class="sm-xml-banner__title" data-i18n="blog.sitemap.xmlHint">{sm.xmlHint}</span>
        <span class="sm-xml-banner__desc" data-i18n="blog.sitemap.xmlDesc">{sm.xmlDesc}</span>
      </span>
      <span class="sm-xml-banner__arrow" aria-hidden="true">→</span>
    </a>

    <div class="sm-layout">
      <section class="sm-card card-surface">
        <header class="sm-card__head">
          <h2 class="sm-card__title" data-i18n="blog.sitemap.mainPages">{sm.mainPages}</h2>
          <span class="sm-card__count">{mainPages.length}</span>
        </header>
        <ul class="sm-chips">
          {
            mainPages.map(link => (
              <li>
                <a href={link.href} class="sm-chip" data-i18n={link.i18n}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="sm-card card-surface">
        <header class="sm-card__head">
          <h2 class="sm-card__title" data-i18n="blog.sitemap.redactTool">{sm.redactTool}</h2>
          <span class="sm-card__count">1</span>
        </header>
        <ul class="sm-chips">
          <li>
            <a href={redactPage.href} class="sm-chip sm-chip--accent" data-i18n={redactPage.i18n}>
              {redactPage.label}
            </a>
          </li>
        </ul>
      </section>

      <section class="sm-card sm-card--wide card-surface">
        <header class="sm-card__head">
          <h2 class="sm-card__title" data-i18n="blog.sitemap.pdfTools">{sm.pdfTools}</h2>
          <span class="sm-card__count">{toolsRegistry.length}</span>
        </header>
        <div class="sm-tool-grid">
          {
            toolGroups.map(group => (
              <div class="sm-tool-group">
                <h3 class="sm-tool-group__title" data-i18n={group.titleI18n}>
                  {group.title}
                </h3>
                <ul class="sm-chips sm-chips--dense">
                  {
                    group.items.map(item => (
                      <li>
                        <a href={item.href} class="sm-chip" data-i18n={item.i18n}>
                          {item.label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="sm-card card-surface">
        <header class="sm-card__head">
          <h2 class="sm-card__title" data-i18n="blog.sitemap.ofdTools">{sm.ofdTools}</h2>
          <span class="sm-card__count">{ofdTools.length + 1}</span>
        </header>
        <ul class="sm-chips">
          <li>
            <a href={ofdHub.href} class="sm-chip sm-chip--accent" data-i18n={ofdHub.i18n}>
              {ofdHub.label}
            </a>
          </li>
          {
            ofdTools.map(tool => (
              <li>
                <a href={tool.href} class="sm-chip" data-i18n={tool.i18n}>
                  {tool.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="sm-card sm-card--wide card-surface">
        <header class="sm-card__head">
          <h2 class="sm-card__title" data-i18n="blog.sitemap.articles">{sm.articles}</h2>
          <span class="sm-card__count">{posts.length}</span>
        </header>
        <ul class="sm-article-list">
          {
            posts.map(post => {
              const titleKey = post.data.i18nKey
                ? `posts.redact.${post.data.i18nKey}.title`
                : undefined;
              return (
                <li>
                  <a
                    href={getPostUrl(post.id, post.filePath, locale)}
                    class="sm-article-link"
                    {...(titleKey ? { "data-i18n": titleKey } : {})}
                  >
                    <span class="sm-article-link__title">{post.data.title}</span>
                    <span class="sm-article-link__arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section class="sm-card sm-card--wide card-surface">
        <header class="sm-card__head">
          <h2 class="sm-card__title" data-i18n="blog.sitemap.tags">{sm.tags}</h2>
          <span class="sm-card__count">{tags.length}</span>
        </header>
        <ul class="sm-chips sm-chips--tags">
          {
            tags.map(({ tag, tagName }) => (
              <li>
                <a href={getRelativeLocaleUrl(locale, `tags/${tag}`)} class="sm-chip sm-chip--tag">
                  #{tagName}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </Main>

  <Footer />
</Layout>

<style>
  :global(.sm-main) {
    max-width: 72rem;
  }

  .sm-xml-banner {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
    padding: 1rem 1.125rem;
    border-radius: 1rem;
    text-decoration: none;
    color: inherit;
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--accent) 10%, var(--card)) 0%,
      var(--card) 55%
    );
    border: 1px solid color-mix(in oklab, var(--accent) 22%, var(--border));
    box-shadow: 0 4px 18px color-mix(in oklab, var(--accent) 10%, transparent);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .sm-xml-banner:hover {
    border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
    transform: translateY(-1px);
    box-shadow: 0 8px 24px color-mix(in oklab, var(--accent) 16%, transparent);
  }

  .sm-xml-banner__icon {
    display: flex;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    background: color-mix(in oklab, var(--accent) 14%, var(--card));
    color: var(--accent);
  }

  .sm-xml-banner__icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .sm-xml-banner__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .sm-xml-banner__title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--foreground);
  }

  .sm-xml-banner__desc {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--muted-foreground);
  }

  .sm-xml-banner__arrow {
    flex-shrink: 0;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--accent);
  }

  .sm-layout {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .sm-layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sm-card--wide {
      grid-column: 1 / -1;
    }
  }

  .sm-card {
    padding: 1.125rem 1.25rem 1.25rem;
    border-radius: 1rem;
  }

  .sm-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 75%, transparent);
  }

  .sm-card__title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--foreground);
  }

  .sm-card__count {
    flex-shrink: 0;
    min-width: 1.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--accent) 10%, var(--muted));
    font-size: 0.6875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: center;
    color: var(--accent);
  }

  .sm-tool-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .sm-tool-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .sm-tool-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .sm-tool-group__title {
    margin-bottom: 0.625rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .sm-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sm-chips--dense {
    gap: 0.4rem;
  }

  .sm-chip {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    padding: 0.45rem 0.8rem;
    border-radius: 0.625rem;
    border: 1px solid color-mix(in oklab, var(--border) 90%, transparent);
    background: color-mix(in oklab, var(--muted) 35%, var(--card));
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--foreground);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;
  }

  .sm-chip:hover {
    border-color: color-mix(in oklab, var(--accent) 40%, var(--border));
    background: color-mix(in oklab, var(--accent) 8%, var(--card));
    color: var(--accent);
    transform: translateY(-1px);
  }

  .sm-chip--accent {
    border-color: color-mix(in oklab, var(--accent) 35%, var(--border));
    background: color-mix(in oklab, var(--accent) 12%, var(--card));
    color: var(--accent);
  }

  .sm-chip--tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted-foreground);
  }

  .sm-article-list {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 768px) {
    .sm-article-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem 1rem;
    }
  }

  .sm-article-link {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    border-radius: 0.75rem;
    border: 1px solid transparent;
    text-decoration: none;
    color: var(--foreground);
    background: color-mix(in oklab, var(--muted) 28%, transparent);
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      color 0.15s ease;
  }

  .sm-article-link:hover {
    border-color: color-mix(in oklab, var(--accent) 30%, var(--border));
    background: color-mix(in oklab, var(--accent) 6%, var(--card));
    color: var(--accent);
  }

  .sm-article-link__title {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .sm-article-link__arrow {
    flex-shrink: 0;
    margin-top: 0.1rem;
    font-size: 0.875rem;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .sm-article-link:hover .sm-article-link__arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
