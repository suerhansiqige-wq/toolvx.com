---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import {
  menuColumnOrder,
  toolsRegistry,
} from "@/data/toolsRegistry";
import { getSortedRenderablePosts } from "@/utils/getRenderablePosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getMenuLabel, getColumnTitle } from "@/i18n/server";
import { useTranslations } from "@/i18n";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const ofdToolEntries = [
  { slug: "ofd-to-pdf", i18nKey: "ofdToPdf" },
  { slug: "ofd-merge", i18nKey: "ofdMerge" },
  { slug: "ofd-to-image", i18nKey: "ofdToImage" },
  { slug: "ofd-to-svg", i18nKey: "ofdToSvg" },
  { slug: "ofd-to-web", i18nKey: "ofdToWeb" },
  { slug: "ofd-to-text", i18nKey: "ofdToText" },
  { slug: "ofd-compress", i18nKey: "ofdCompress" },
  { slug: "ofd-reader", i18nKey: "ofdReader" },
  { slug: "ofd-to-long-image", i18nKey: "ofdToLongImage" },
] as const;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getSortedRenderablePosts();
const tags = getUniqueTags(posts);

const mainPages = [
  { href: getRelativeLocaleUrl(locale, ""), label: t.nav.home, i18n: "site.nav.home" },
  { href: getRelativeLocaleUrl(locale, "posts"), label: t.nav.posts, i18n: "site.nav.posts" },
  { href: getRelativeLocaleUrl(locale, "tags"), label: t.nav.tags, i18n: "site.nav.tags" },
  { href: getRelativeLocaleUrl(locale, "about"), label: t.nav.about, i18n: "site.nav.about" },
  ...(config.features.showArchives !== false
    ? [
        {
          href: getRelativeLocaleUrl(locale, "archives"),
          label: t.nav.archives,
          i18n: "site.nav.archives",
        },
      ]
    : []),
  { href: getRelativeLocaleUrl(locale, "search"), label: t.nav.search, i18n: "site.nav.search" },
];

const toolGroups = menuColumnOrder.map(column => ({
  column,
  title: getColumnTitle(column),
  titleI18n: `menu.columns.${column}`,
  items: toolsRegistry
    .filter(tool => tool.column === column)
    .map(tool => ({
      href: getRelativeLocaleUrl(locale, `tools/${tool.slug}`),
      label: getMenuLabel(tool.i18nKey),
      i18n: `menu.tools.${tool.i18nKey}`,
    })),
}));

const redactPage = {
  href: getRelativeLocaleUrl(locale, "redact-preview"),
  label: t.nav.redact,
  i18n: "site.nav.redact",
};

const ofdHub = {
  href: getRelativeLocaleUrl(locale, "ofd-tools"),
  label: "OFD Toolbox",
  i18n: "ofd.hub.title",
};

const ofdTools = ofdToolEntries.map(tool => ({
  href: getRelativeLocaleUrl(locale, `ofd-tools/${tool.slug}`),
  label: tool.slug,
  i18n: `ofd.tools.${tool.i18nKey}.title`,
}));

const xmlSitemapUrl = getAssetPath("sitemap-index.xml");
---

<Layout title={`${t.pages.sitemapTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <Main
    pageTitle={t.pages.sitemapTitle}
    pageDesc={t.pages.sitemapDesc}
    pageTitleI18n="blog.pages.sitemapTitle"
    pageDescI18n="blog.pages.sitemapDesc"
  >
    <p class="text-muted-foreground mb-8 text-sm">
      <a
        href={xmlSitemapUrl}
        class="text-accent font-medium hover:underline"
        data-i18n="blog.sitemap.xmlHint"
      >
        XML sitemap for search engines
      </a>
    </p>

    <div class="sitemap-grid">
      <section class="sitemap-section">
        <h2 class="sitemap-section__title" data-i18n="blog.sitemap.mainPages">
          Main pages
        </h2>
        <ul class="sitemap-list">
          {
            mainPages.map(link => (
              <li>
                <a href={link.href} data-i18n={link.i18n}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="sitemap-section">
        <h2 class="sitemap-section__title" data-i18n="blog.sitemap.redactTool">
          Redaction tool
        </h2>
        <ul class="sitemap-list">
          <li>
            <a href={redactPage.href} data-i18n={redactPage.i18n}>
              {redactPage.label}
            </a>
          </li>
        </ul>
      </section>

      <section class="sitemap-section sitemap-section--wide">
        <h2 class="sitemap-section__title" data-i18n="blog.sitemap.pdfTools">
          PDF tools
        </h2>
        <div class="sitemap-tool-groups">
          {
            toolGroups.map(group => (
              <div class="sitemap-tool-group">
                <h3 class="sitemap-tool-group__title" data-i18n={group.titleI18n}>
                  {group.title}
                </h3>
                <ul class="sitemap-list">
                  {
                    group.items.map(item => (
                      <li>
                        <a href={item.href} data-i18n={item.i18n}>
                          {item.label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="sitemap-section">
        <h2 class="sitemap-section__title" data-i18n="blog.sitemap.ofdTools">
          OFD tools
        </h2>
        <ul class="sitemap-list">
          <li>
            <a href={ofdHub.href} data-i18n={ofdHub.i18n}>
              {ofdHub.label}
            </a>
          </li>
          {
            ofdTools.map(tool => (
              <li>
                <a href={tool.href} data-i18n={tool.i18n}>
                  {tool.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="sitemap-section sitemap-section--wide">
        <h2 class="sitemap-section__title" data-i18n="blog.sitemap.articles">
          Articles & guides
        </h2>
        <ul class="sitemap-list sitemap-list--columns">
          {
            posts.map(post => {
              const titleKey = post.data.i18nKey
                ? `posts.redact.${post.data.i18nKey}.title`
                : undefined;
              return (
                <li>
                  <a
                    href={getPostUrl(post.id, post.filePath, locale)}
                    {...(titleKey ? { "data-i18n": titleKey } : {})}
                  >
                    {post.data.title}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section class="sitemap-section">
        <h2 class="sitemap-section__title" data-i18n="blog.sitemap.tags">
          Tags
        </h2>
        <ul class="sitemap-list sitemap-list--columns">
          {
            tags.map(({ tag, tagName }) => (
              <li>
                <a href={getRelativeLocaleUrl(locale, `tags/${tag}`)}>{tagName}</a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </Main>

  <Footer />
</Layout>

<style>
  .sitemap-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .sitemap-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sitemap-section--wide {
      grid-column: 1 / -1;
    }
  }

  .sitemap-section__title {
    color: var(--foreground);
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .sitemap-tool-groups {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .sitemap-tool-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .sitemap-tool-groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .sitemap-tool-group__title {
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .sitemap-list {
    display: grid;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sitemap-list--columns {
    gap: 0.35rem 1rem;
  }

  @media (min-width: 640px) {
    .sitemap-list--columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .sitemap-list a {
    color: var(--accent);
    font-size: 0.9375rem;
    line-height: 1.45;
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 3px;
  }

  .sitemap-list a:hover {
    text-decoration-style: solid;
  }
</style>
