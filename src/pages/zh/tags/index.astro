---
import { getRenderablePosts } from "@/utils/getRenderablePosts";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = "zh";
const t = useTranslations(locale);
const posts = await getRenderablePosts();
const postsNoDraft = posts.filter(({ data }) => !data.draft);
const tags = getUniqueTags(postsNoDraft);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`} description={t.pages.tagsDesc} titleI18n="blog.pages.tagsTitle" descriptionI18n="blog.pages.tagsDesc" lang="zh">
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.tagsTitle} pageTitleI18n="blog.pages.tagsTitle" pageDesc={t.pages.tagsDesc}>
    <ul class="flex flex-wrap gap-3">
      {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} />)}
    </ul>
  </Main>
  <Footer />
</Layout>
